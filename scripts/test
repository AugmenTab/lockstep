#!/usr/bin/env bash
# Run pytest inside the repository virtualenv; extra arguments pass through.
#
#   scripts/test                          # whole suite
#   scripts/test tests/test_x.py -q -x    # focused run
#
# Does not modify tracked content or install anything.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export PATH="$repo_root/.venv/bin:$PATH"

exec pytest "$@"
