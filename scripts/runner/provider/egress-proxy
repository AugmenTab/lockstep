#!/usr/bin/env python3
# The provider-egress proxy (contract C-P4.L L2-L4; DG-17 D-17.1, D-17.7).
#
# Runs in its own container, started by the host helper for one live role run
# and removed with it. The role's container has no network but the run's own
# internal network, on which this proxy is the only other member; it reaches
# the provider only through here. The proxy:
#
#   - answers only POST /v1/messages (the Messages API), and sends it only to
#     the one fixed upstream (api.anthropic.com:443, TLS verified); nothing a
#     request says (Host, an absolute URL, a redirect) can name another host;
#   - holds the credential: the role's container never sees it. Any key the
#     client sends is dropped and the owner's key is set here;
#   - admits a request only if it asks for the configured model, at most the
#     configured max_tokens, only the role's tools (no server tool, no MCP
#     server, no image or document), and only allowed beta features;
#   - reserves, before forwarding, the request's largest possible charge
#     against the owner's budget and token limit in a durable ledger, and
#     settles it afterwards from the usage the provider reported; a request
#     whose usage cannot be read stays charged at its reservation;
#   - never follows or passes on a redirect.
#
#   egress-proxy describe --config FILE     ("ok claude-code MODEL EFFORT MAX-TOKENS")
#   egress-proxy admit --config FILE --credential FILE --ledger DIR
#   egress-proxy serve --config FILE --credential FILE --ledger DIR --run RUN
#                      --role readonly|write [--upstream HOST:PORT] [--ca FILE]
#
# The configuration (owner-written, "key value" lines, every key exactly once):
#   lockstep-provider 1
#   provider claude-code
#   model MODEL                      effort low|medium|high|xhigh|max
#   pricing VERSION                  (the pricing basis these prices come from)
#   price-input N                    micro-USD per million tokens, and so on for
#   price-output N                   price-cache-write-5m, price-cache-write-1h,
#   price-cache-read N               (all whole numbers)
#   long-context-tokens N            above this many prompt tokens, the
#   long-context-input-percent N     long-context prices apply (percent of the
#   long-context-output-percent N    ordinary price)
#   budget-micro-usd N               the whole budget, every run together
#   token-limit N                    all tokens (input, cache, output) together
#   invocation-limit N               live role runs together
#   request-max-tokens N             the largest max_tokens one request may ask
#   invocation-output-tokens N       output tokens one run may use
#   invocation-requests N            requests one run may make
#
# The ledger (DIR/ledger, append-only, one line each, synced):
#   invocation RUN UNIX
#   reserve RUN N MICRO TOKENS OUTPUT
#   settle RUN N MICRO TOKENS OUTPUT known|unknown|error IN OUT CW5 CW1H CR STATUS
# A reservation never settled (the proxy stopped mid-request) stays charged.
# DIR/runs/RUN is the run's summary, rewritten after every request; DIR/runs/
# RUN.ready appears when the proxy listens. Nothing here ever writes the key.
import http.client
import http.server
import json
import math
import os
import re
import signal
import socket
import ssl
import sys
import threading
import time

PROVIDER = "claude-code"
MODELS = ("claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5", "claude-fable-5-1")
EFFORTS = ("low", "medium", "high", "xhigh", "max")
NUMBER_KEYS = (
    "price-input", "price-output", "price-cache-write-5m", "price-cache-write-1h", "price-cache-read",
    "long-context-tokens", "long-context-input-percent", "long-context-output-percent",
    "budget-micro-usd", "token-limit", "invocation-limit", "request-max-tokens",
    "invocation-output-tokens", "invocation-requests",
)
KEYS = ("lockstep-provider", "provider", "model", "effort", "pricing") + NUMBER_KEYS
UPSTREAM = "api.anthropic.com:443"
# The role's tools (C-P4.L L1): the pinned CLI's file and command tools, as it
# names them with --bare --tools "Read Edit Bash" (observed, 2.1.312). Whether a
# role may change the tree is the container's mount, not this list. Never an
# agent, a web tool, a server tool or an MCP server.
TOOLS = {
    "readonly": {"Read", "Edit", "Bash"},
    "write": {"Read", "Edit", "Bash"},
}
# Exactly the beta features the pinned CLI sends (observed, 2.1.312); none of
# them changes the price or adds a tool. Anything else is refused, never dropped.
BETAS = {
    "claude-code-20250219",
    "interleaved-thinking-2025-05-14",
    "context-management-2025-06-27",
    "per-turn-control-2026-07-01",
    "thinking-token-count-2026-05-13",
    "effort-2025-11-24",
}
BLOCKS = {"text", "tool_use", "tool_result", "thinking", "redacted_thinking"}
MAX_BODY = 8 * 1024 * 1024
# Tokens the provider may add to a prompt beyond its bytes (its tool-use system prompt).
PROMPT_OVERHEAD = 4096
STOPPING = ("budget-exhausted", "token-limit-reached", "output-allowance-exhausted", "requests-exhausted",
            "model-refused", "effort-refused", "tool-refused", "content-refused", "beta-refused", "path-refused",
            "max-tokens-refused", "body-refused", "auth-refused", "usage-unknown", "redirect-refused")


class Refusal(Exception):
    def __init__(self, code):
        super().__init__(code)
        self.code = code


def read_config(path):
    try:
        with open(path, encoding="ascii") as f:
            text = f.read(65536)
    except (OSError, UnicodeDecodeError):
        raise Refusal("provider-config-unreadable")
    values = {}
    for line in text.split("\n"):
        if line == "":
            continue
        m = re.fullmatch(r"([a-z0-9-]+) ([!-~]{1,64})", line)
        if not m or m.group(1) not in KEYS or m.group(1) in values:
            raise Refusal("provider-config-invalid")
        values[m.group(1)] = m.group(2)
    if set(values) != set(KEYS) or values["lockstep-provider"] != "1" or values["provider"] != PROVIDER:
        raise Refusal("provider-config-invalid")
    if values["model"] not in MODELS:
        raise Refusal("provider-model-unsupported")
    if values["effort"] not in EFFORTS:
        raise Refusal("provider-effort-unsupported")
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", values["pricing"]):
        raise Refusal("provider-config-invalid")
    config = dict(values)
    for key in NUMBER_KEYS:
        if not re.fullmatch(r"[0-9]{1,15}", values[key]):
            raise Refusal("provider-config-invalid")
        config[key] = int(values[key])
    for key in ("price-input", "price-output", "invocation-limit", "request-max-tokens",
                "invocation-output-tokens", "invocation-requests", "long-context-input-percent",
                "long-context-output-percent"):
        if config[key] < 1:
            raise Refusal("provider-config-invalid")
    if config["long-context-input-percent"] < 100 or config["long-context-output-percent"] < 100:
        raise Refusal("provider-config-invalid")
    if config["request-max-tokens"] > config["invocation-output-tokens"]:
        raise Refusal("provider-config-invalid")
    return config


def read_credential(path):
    try:
        st = os.lstat(path)
    except OSError:
        raise Refusal("credential-missing")
    if not os.path.isfile(path) or os.path.islink(path):
        raise Refusal("credential-unusable")
    if st.st_mode & 0o077:
        raise Refusal("credential-unusable")
    try:
        with open(path, "rb") as f:
            raw = f.read(4097)
    except OSError:
        raise Refusal("credential-unreadable")
    if len(raw) > 4096:
        raise Refusal("credential-malformed")
    key = raw.rstrip(b"\n")
    if not re.fullmatch(rb"sk-ant-[A-Za-z0-9_-]{16,400}", key):
        raise Refusal("credential-malformed")
    return key.decode("ascii")


class Ledger:
    """The durable budget: every reservation and settlement, synced, never rewritten."""

    def __init__(self, directory):
        self.directory = directory
        self.path = os.path.join(directory, "ledger")
        self.lock = threading.Lock()

    def totals(self):
        micro = tokens = invocations = 0
        open_reserves = {}
        try:
            with open(self.path, encoding="ascii") as f:
                lines = f.read().split("\n")
        except FileNotFoundError:
            lines = []
        except (OSError, UnicodeDecodeError):
            raise Refusal("ledger-unreadable")
        for line in lines:
            if line == "":
                continue
            parts = line.split(" ")
            try:
                if parts[0] == "invocation" and len(parts) == 3:
                    invocations += 1
                elif parts[0] == "reserve" and len(parts) == 6:
                    open_reserves[(parts[1], parts[2])] = (int(parts[3]), int(parts[4]))
                elif parts[0] == "settle" and len(parts) == 13:
                    open_reserves.pop((parts[1], parts[2]), None)
                    micro += int(parts[3])
                    tokens += int(parts[4])
                else:
                    raise ValueError(line)
            except ValueError:
                # A ledger that cannot be read whole cannot prove what is left.
                raise Refusal("ledger-unreadable")
        for m, t in open_reserves.values():
            micro += m
            tokens += t
        return micro, tokens, invocations

    def append(self, line):
        fd = os.open(self.path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, (line + "\n").encode("ascii"))
            os.fsync(fd)
        finally:
            os.close(fd)


def admit(config, ledger):
    micro, tokens, invocations = ledger.totals()
    if invocations >= config["invocation-limit"]:
        raise Refusal("invocation-limit-reached")
    # The smallest request still possible must fit what is left.
    if micro >= config["budget-micro-usd"]:
        raise Refusal("budget-exhausted")
    if tokens + PROMPT_OVERHEAD >= config["token-limit"]:
        raise Refusal("token-limit-reached")


def cost(config, prompt_tokens, usage):
    """The charge in micro-USD (rounded up) for one response's usage."""
    long_context = prompt_tokens > config["long-context-tokens"]
    pin = config["long-context-input-percent"] if long_context else 100
    pout = config["long-context-output-percent"] if long_context else 100
    total = (usage["in"] * config["price-input"] * pin
             + usage["cw5"] * config["price-cache-write-5m"] * pin
             + usage["cw1h"] * config["price-cache-write-1h"] * pin
             + usage["cr"] * config["price-cache-read"] * pin
             + usage["out"] * config["price-output"] * pout)
    return math.ceil(total / (1000000 * 100))


def reservation(config, body_bytes, max_tokens):
    """The largest charge a request can cause: every prompt token at the dearest
    input price, and every token it may write at the output price, at the
    long-context rates if the prompt could be long."""
    prompt = body_bytes + PROMPT_OVERHEAD
    long_context = prompt > config["long-context-tokens"]
    pin = config["long-context-input-percent"] if long_context else 100
    pout = config["long-context-output-percent"] if long_context else 100
    dearest = max(config["price-input"], config["price-cache-write-5m"], config["price-cache-write-1h"],
                  config["price-cache-read"])
    total = prompt * dearest * pin + max_tokens * config["price-output"] * pout
    return math.ceil(total / (1000000 * 100)), prompt + max_tokens


def check_request(config, role, body, beta_header):
    try:
        request = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        raise Refusal("body-refused")
    if not isinstance(request, dict):
        raise Refusal("body-refused")
    if request.get("model") != config["model"]:
        raise Refusal("model-refused")
    max_tokens = request.get("max_tokens")
    if not isinstance(max_tokens, int) or isinstance(max_tokens, bool) or not 1 <= max_tokens <= config["request-max-tokens"]:
        raise Refusal("max-tokens-refused")
    for key in ("mcp_servers", "container"):
        if key in request:
            raise Refusal("tool-refused")
    # The configured effort only: no other effort, and no other output setting.
    output = request.get("output_config", {"effort": config["effort"]})
    if not isinstance(output, dict) or set(output) != {"effort"} or output["effort"] != config["effort"]:
        raise Refusal("effort-refused")
    tools = request.get("tools", [])
    if not isinstance(tools, list):
        raise Refusal("body-refused")
    for tool in tools:
        if not isinstance(tool, dict) or tool.get("type", "custom") != "custom" or tool.get("name") not in TOOLS[role]:
            raise Refusal("tool-refused")
    system = request.get("system", [])
    if isinstance(system, list):
        for block in system:
            if not isinstance(block, dict) or block.get("type") != "text":
                raise Refusal("content-refused")
    elif not isinstance(system, str):
        raise Refusal("body-refused")
    messages = request.get("messages")
    if not isinstance(messages, list):
        raise Refusal("body-refused")
    for message in messages:
        content = message.get("content") if isinstance(message, dict) else None
        if isinstance(content, str):
            continue
        if not isinstance(content, list):
            raise Refusal("body-refused")
        for block in content:
            if not isinstance(block, dict) or block.get("type") not in BLOCKS:
                raise Refusal("content-refused")
            if block.get("type") == "tool_result" and isinstance(block.get("content"), list):
                for inner in block["content"]:
                    if not isinstance(inner, dict) or inner.get("type") != "text":
                        raise Refusal("content-refused")
    betas = []
    for value in beta_header:
        for beta in value.split(","):
            beta = beta.strip()
            if beta == "":
                continue
            if beta not in BETAS:
                raise Refusal("beta-refused")
            betas.append(beta)
    return max_tokens, betas


def usage_from(raw):
    """The five counts from a usage object, or None if it is not exactly readable."""
    if not isinstance(raw, dict):
        return None
    def count(key):
        v = raw.get(key, 0)
        if v is None:
            return 0
        if isinstance(v, bool) or not isinstance(v, int) or v < 0:
            raise ValueError(key)
        return v
    try:
        server = raw.get("server_tool_use")
        if isinstance(server, dict) and any(isinstance(v, int) and v > 0 for v in server.values()):
            return None
        split = raw.get("cache_creation")
        written = count("cache_creation_input_tokens")
        if isinstance(split, dict):
            cw5 = split.get("ephemeral_5m_input_tokens", 0) or 0
            cw1h = split.get("ephemeral_1h_input_tokens", 0) or 0
            if not all(isinstance(x, int) and not isinstance(x, bool) and x >= 0 for x in (cw5, cw1h)):
                return None
            if cw5 + cw1h != written:
                # An unknown split is charged at the dearer rate.
                cw5, cw1h = 0, written
        else:
            cw5, cw1h = 0, written
        return {"in": count("input_tokens"), "out": count("output_tokens"), "cw5": cw5, "cw1h": cw1h,
                "cr": count("cache_read_input_tokens")}
    except ValueError:
        return None


class StreamUsage:
    """Reads a Messages API event stream as it passes and keeps its usage."""

    def __init__(self):
        self.pending = b""
        self.start = None
        self.output = None
        self.stopped = False
        self.broken = False

    def feed(self, chunk):
        self.pending += chunk
        while b"\n" in self.pending:
            line, self.pending = self.pending.split(b"\n", 1)
            line = line.rstrip(b"\r")
            if not line.startswith(b"data:"):
                continue
            try:
                event = json.loads(line[5:].strip())
            except ValueError:
                continue
            if not isinstance(event, dict):
                continue
            kind = event.get("type")
            if kind == "message_start":
                message = event.get("message")
                self.start = usage_from(message.get("usage") if isinstance(message, dict) else None)
                if self.start is None:
                    self.broken = True
            elif kind == "message_delta":
                u = event.get("usage")
                out = u.get("output_tokens") if isinstance(u, dict) else None
                if isinstance(out, int) and not isinstance(out, bool) and out >= 0:
                    self.output = out
                    # Later counts of the prompt, when the provider sends them, replace the first.
                    for key, name in (("in", "input_tokens"), ("cr", "cache_read_input_tokens")):
                        if self.start is not None and isinstance(u.get(name), int) and u[name] >= 0:
                            self.start[key] = u[name]
                else:
                    self.broken = True
            elif kind == "message_stop":
                self.stopped = True

    def result(self):
        if self.broken or self.start is None or self.output is None or not self.stopped:
            return None
        usage = dict(self.start)
        usage["out"] = self.output
        return usage


class Proxy:
    def __init__(self, config, credential, ledger, run, role, upstream, ca):
        self.config = config
        self.credential = credential
        self.ledger = ledger
        self.run = run
        self.role = role
        host, _, port = upstream.rpartition(":")
        self.host = host
        self.port = int(port)
        self.context = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
        self.lock = threading.Lock()
        self.requests = 0
        self.output_settled = 0
        self.output_open = 0
        self.summary = {"requests": 0, "denied": 0, "forwarded": 0, "known": 0, "unknown": 0, "errors": 0,
                        "in": 0, "out": 0, "cw5": 0, "cw1h": 0, "cr": 0, "micro": 0, "stop": "-",
                        "statuses": "-", "betas": "-", "paths": "-"}
        self.statuses = {}
        self.betas = set()
        self.paths = set()

    def note_stop(self, code):
        if self.summary["stop"] == "-" and code in STOPPING:
            self.summary["stop"] = code

    def write_summary(self):
        s = dict(self.summary)
        s["statuses"] = ",".join("%s:%d" % kv for kv in sorted(self.statuses.items())) or "-"
        s["betas"] = ",".join(sorted(self.betas)) or "-"
        s["paths"] = ",".join(sorted(self.paths)) or "-"
        try:
            s["spent"], s["tokens"], _ = self.ledger.totals()
        except Refusal:
            s["spent"], s["tokens"] = "unknown", "unknown"
        s["model"] = self.config["model"]
        s["effort"] = self.config["effort"]
        s["pricing"] = self.config["pricing"]
        text = "".join("%s %s\n" % (k, s[k]) for k in (
            "model", "effort", "pricing", "requests", "denied", "forwarded", "known", "unknown", "errors",
            "in", "out", "cw5", "cw1h", "cr", "micro", "spent", "tokens", "stop", "statuses", "betas", "paths"))
        runs = os.path.join(self.ledger.directory, "runs")
        tmp = os.path.join(runs, "." + self.run)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        try:
            os.write(fd, text.encode("ascii"))
            os.fsync(fd)
        finally:
            os.close(fd)
        os.replace(tmp, os.path.join(runs, self.run))

    def deny(self, code):
        with self.lock:
            self.summary["denied"] += 1
            self.note_stop(code)
            self.write_summary()

    def admit_request(self, max_tokens, body_bytes):
        """Checks the run's and the budget's limits and records the reservation."""
        with self.ledger.lock, self.lock:
            if self.requests >= self.config["invocation-requests"]:
                raise Refusal("requests-exhausted")
            if self.output_settled + self.output_open + max_tokens > self.config["invocation-output-tokens"]:
                raise Refusal("output-allowance-exhausted")
            micro, tokens, _ = self.ledger.totals()
            reserve, reserve_tokens = reservation(self.config, body_bytes, max_tokens)
            if micro + reserve > self.config["budget-micro-usd"]:
                raise Refusal("budget-exhausted")
            if tokens + reserve_tokens > self.config["token-limit"]:
                raise Refusal("token-limit-reached")
            self.requests += 1
            number = self.requests
            self.output_open += max_tokens
            self.ledger.append("reserve %s %d %d %d %d" % (self.run, number, reserve, reserve_tokens, max_tokens))
            self.summary["requests"] = self.requests
            self.write_summary()
            return number, reserve, reserve_tokens

    def settle(self, number, reserve, reserve_tokens, max_tokens, prompt_tokens, usage, status):
        with self.ledger.lock, self.lock:
            self.output_open -= max_tokens
            self.statuses[str(status)] = self.statuses.get(str(status), 0) + 1
            if usage is None:
                state = "unknown" if 200 <= status < 300 else "error"
                micro, tokens, out = reserve, reserve_tokens, max_tokens
                fields = (0, 0, 0, 0, 0)
                self.summary["unknown" if state == "unknown" else "errors"] += 1
                if state == "unknown":
                    self.note_stop("usage-unknown")
            else:
                state = "known"
                micro = cost(self.config, prompt_tokens(usage), usage)
                out = usage["out"]
                tokens = usage["in"] + usage["cw5"] + usage["cw1h"] + usage["cr"] + out
                fields = (usage["in"], usage["out"], usage["cw5"], usage["cw1h"], usage["cr"])
                self.summary["known"] += 1
                for k in ("in", "out", "cw5", "cw1h", "cr"):
                    self.summary[k] += usage[k]
            self.output_settled += out
            self.summary["micro"] += micro
            self.ledger.append("settle %s %d %d %d %d %s %d %d %d %d %d %d" % (
                (self.run, number, micro, tokens, out, state) + fields + (status,)))
            self.write_summary()


def prompt_tokens(usage):
    return usage["in"] + usage["cw5"] + usage["cw1h"] + usage["cr"]


def handler_for(proxy):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "lockstep-egress"
        sys_version = ""

        def log_message(self, *_):
            pass

        def refuse(self, status, code):
            proxy.deny(code)
            body = json.dumps({"type": "error", "error": {"type": "lockstep_egress", "message": code}}).encode()
            self.send_response(status)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.send_header("connection", "close")
            self.end_headers()
            self.wfile.write(body)
            self.close_connection = True

        def do_GET(self):
            self.refuse(403, "path-refused")

        do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = do_CONNECT = do_GET

        def do_POST(self):
            path = self.path
            with proxy.lock:
                proxy.paths.add(re.sub(r"[^A-Za-z0-9/?=._-]", "_", path)[:80])
            if path not in ("/v1/messages", "/v1/messages?beta=true"):
                self.refuse(403, "path-refused")
                return
            length = self.headers.get("content-length")
            if length is None or not length.isdigit() or int(length) > MAX_BODY:
                self.refuse(413, "body-refused")
                return
            body = self.rfile.read(int(length))
            try:
                max_tokens, betas = check_request(proxy.config, proxy.role, body, self.headers.get_all("anthropic-beta") or [])
                number, reserve, reserve_tokens = proxy.admit_request(max_tokens, len(body))
            except Refusal as r:
                self.refuse(403, r.code)
                return
            with proxy.lock:
                proxy.betas.update(betas)
                proxy.summary["forwarded"] += 1
            headers = {"content-type": "application/json", "content-length": str(len(body)),
                       "x-api-key": proxy.credential, "host": proxy.host}
            version = self.headers.get("anthropic-version")
            if version and re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", version):
                headers["anthropic-version"] = version
            if betas:
                headers["anthropic-beta"] = ",".join(betas)
            usage = None
            status = 502
            try:
                connection = http.client.HTTPSConnection(proxy.host, proxy.port, timeout=600, context=proxy.context)
                connection.request("POST", "/v1/messages" + ("?beta=true" if path.endswith("?beta=true") else ""), body, headers)
                response = connection.getresponse()
                status = response.status
                if 300 <= status < 400:
                    response.read(65536)
                    connection.close()
                    proxy.settle(number, reserve, reserve_tokens, max_tokens, prompt_tokens, None, status)
                    self.refuse(502, "redirect-refused")
                    return
                if status in (401, 403):
                    with proxy.lock:
                        proxy.note_stop("auth-refused")
                kind = response.getheader("content-type", "")
                self.send_response(status)
                for name in ("content-type", "request-id", "retry-after", "anthropic-ratelimit-requests-remaining"):
                    value = response.getheader(name)
                    if value:
                        self.send_header(name, value)
                self.send_header("connection", "close")
                self.end_headers()
                self.close_connection = True
                stream = StreamUsage() if kind.startswith("text/event-stream") else None
                whole = b""
                while True:
                    chunk = response.read1(65536)
                    if not chunk:
                        break
                    if stream is not None:
                        stream.feed(chunk)
                    elif len(whole) <= MAX_BODY:
                        whole += chunk
                    self.wfile.write(chunk)
                    self.wfile.flush()
                connection.close()
                if 200 <= status < 300:
                    if stream is not None:
                        usage = stream.result()
                    else:
                        try:
                            parsed = json.loads(whole)
                            usage = usage_from(parsed.get("usage")) if isinstance(parsed, dict) else None
                        except ValueError:
                            usage = None
            except (OSError, http.client.HTTPException, ssl.SSLError):
                usage = None
                status = 502 if status in (0, 502) else status
            proxy.settle(number, reserve, reserve_tokens, max_tokens, prompt_tokens, usage, status)

    return Handler


def arguments(argv, names):
    values = {}
    i = 0
    while i < len(argv):
        name = argv[i]
        if not name.startswith("--") or name[2:] not in names or i + 1 >= len(argv) or name[2:] in values:
            raise Refusal("usage")
        values[name[2:]] = argv[i + 1]
        i += 2
    return values


def main():
    if len(sys.argv) < 2:
        print("usage: egress-proxy describe|admit|serve ...", file=sys.stderr)
        return 64
    command = sys.argv[1]
    try:
        if command == "describe":
            a = arguments(sys.argv[2:], {"config"})
            config = read_config(a["config"])
            print("ok %s %s %s %d" % (PROVIDER, config["model"], config["effort"], config["request-max-tokens"]))
            return 0
        if command == "admit":
            a = arguments(sys.argv[2:], {"config", "credential", "ledger"})
            config = read_config(a["config"])
            read_credential(a["credential"])
            admit(config, Ledger(a["ledger"]))
            print("ok")
            return 0
        if command != "serve":
            raise Refusal("usage")
        a = arguments(sys.argv[2:], {"config", "credential", "ledger", "run", "role", "upstream", "ca"})
        for need in ("config", "credential", "ledger", "run", "role"):
            if need not in a:
                raise Refusal("usage")
        if not re.fullmatch(r"[0-9a-f]{32}", a["run"]) or a["role"] not in TOOLS:
            raise Refusal("usage")
        upstream = a.get("upstream", UPSTREAM)
        if not re.fullmatch(r"[a-z0-9.-]{1,253}:[0-9]{1,5}", upstream):
            raise Refusal("usage")
        config = read_config(a["config"])
        credential = read_credential(a["credential"])
        ledger = Ledger(a["ledger"])
        os.makedirs(os.path.join(a["ledger"], "runs"), mode=0o700, exist_ok=True)
        with ledger.lock:
            admit(config, ledger)
            ledger.append("invocation %s %d" % (a["run"], int(time.time())))
        proxy = Proxy(config, credential, ledger, a["run"], a["role"], upstream, a.get("ca"))
        proxy.write_summary()
        # Listen only on the run's own network: at start it is the container's one interface.
        address = socket.gethostbyname(socket.gethostname())
        server = http.server.ThreadingHTTPServer((address, 8080), handler_for(proxy))
        server.daemon_threads = True
        signal.signal(signal.SIGTERM, lambda *_: threading.Thread(target=server.shutdown, daemon=True).start())
        ready = os.path.join(a["ledger"], "runs", a["run"] + ".ready")
        with open(ready, "w", encoding="ascii") as f:
            f.write("%s\n" % address)
        server.serve_forever()
        with proxy.lock:
            proxy.write_summary()
        return 0
    except Refusal as r:
        print("refuse %s" % r.code)
        return 75


if __name__ == "__main__":
    sys.exit(main())
