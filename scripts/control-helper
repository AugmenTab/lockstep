#!/usr/bin/env bash
# The control pane's host helper (contract C-P3.1 L7-L9, §4).
#
#   scripts/control-helper --state DIR [--instance NAME]
#
# Started in the background by ./lockstep as the invoking user; stopped by
# `lockstep stop` (SIGTERM). It reads signed requests that the control pane
# writes to DIR/pane/requests/, runs at most one allowlisted operation at a
# time, and writes signed results to DIR/pane/results/. It is the only part of
# the control pane that may use Docker, and only through fixed commands: no
# text from a request ever reaches a shell or a command line.
#
# Protocol version 1. Allowlist: status (expect any).
# Journal: DIR/helper/journal ("<unix> start|end|refused <id> <op|outcome|reason>").
set -u
umask 077
export LC_ALL=C

here=$(cd "$(dirname "$0")" && pwd -P)
root=$(dirname "$here")

usage() {
  echo "usage: scripts/control-helper --state DIR [--instance NAME] [--service-port N] [--projects DIR]" >&2
  exit 64
}

state=""
instance=""
service_port=8000
projects=""
while [ $# -gt 0 ]; do
  case $1 in
    --state) [ $# -ge 2 ] || usage; state=$2; shift 2 ;;
    --instance) [ $# -ge 2 ] || usage; instance=$2; shift 2 ;;
    --service-port) [ $# -ge 2 ] || usage; service_port=$2; shift 2 ;;
    --projects) [ $# -ge 2 ] || usage; projects=$2; shift 2 ;;
    *) usage ;;
  esac
done
case $projects in
  "" | /*) ;;
  *) echo "control-helper: --projects must be an absolute path" >&2; exit 64 ;;
esac
case $service_port in
  "" | *[!0-9]*) usage ;;
esac
if [ "$service_port" -lt 1 ] || [ "$service_port" -gt 65535 ]; then usage; fi
[ -n "$state" ] || usage
case $state in
  /*) ;;
  *) echo "control-helper: --state must be an absolute path" >&2; exit 64 ;;
esac
if [ -n "$instance" ]; then
  case $instance in
    service | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) usage ;;
  esac
fi

pane=$state/pane
helper=$state/helper
requests=$pane/requests
results=$pane/results

mode_of() {
  stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null
}

# A directory this user owns, that is not a symlink, and that no one else can use.
private_dir() {
  [ -d "$1" ] && [ ! -L "$1" ] && [ -O "$1" ] || return 1
  case $(mode_of "$1") in
    *00) return 0 ;;
    *) return 1 ;;
  esac
}

fatal() {
  echo "control-helper: $*" >&2
  exit 66
}

private_dir "$state" || fatal "the state directory $state must be a directory owned by this user with mode 0700"
private_dir "$helper" || fatal "$helper must be a directory owned by this user with mode 0700"
private_dir "$pane" || fatal "$pane must be a directory owned by this user with mode 0700"

log() {
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$helper/helper.log"
}
journal() {
  printf '%s %s\n' "$(date +%s)" "$*" >> "$helper/journal"
}

# One helper per state directory: a lock directory holding the owner's PID.
lock=$helper/lock
take_lock() {
  if mkdir "$lock" 2>/dev/null; then
    echo $$ > "$lock/pid"
    return 0
  fi
  local owner
  owner=$(cat "$lock/pid" 2>/dev/null || true)
  case $owner in
    "" | *[!0-9]*) ;;
    *)
      if kill -0 "$owner" 2>/dev/null; then
        echo "control-helper: already running for $state (pid $owner)" >&2
        exit 75
      fi
      ;;
  esac
  rm -rf "$lock"
  mkdir "$lock" 2>/dev/null || { echo "control-helper: already running for $state" >&2; exit 75; }
  echo $$ > "$lock/pid"
}
take_lock
release_lock() {
  [ "$(cat "$lock/pid" 2>/dev/null)" = $$ ] && rm -rf "$lock"
}
trap release_lock EXIT

# The channel key: 32 bytes as 64 lower-case hex characters.
key_hex=$(head -c 64 "$helper/channel.key" 2>/dev/null || true)
case $key_hex in
  *[!0123456789abcdef]* | "") fatal "$helper/channel.key is missing or invalid" ;;
esac
[ ${#key_hex} -eq 64 ] || fatal "$helper/channel.key is missing or invalid"

timeout=${LOCKSTEP_HELPER_TIMEOUT:-90}
case $timeout in
  "" | *[!0-9]*) timeout=90 ;;
esac
if [ "$timeout" -lt 1 ] || [ "$timeout" -gt 300 ]; then timeout=90; fi

# HMAC-SHA256 (RFC 2104) with printf and the system's SHA-256 tool.
if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum | cut -d ' ' -f 1; }
else
  sha256() { shasum -a 256 | cut -d ' ' -f 1; }
fi
ipad=""
opad=""
i=0
while [ $i -lt 64 ]; do
  if [ $i -lt 32 ]; then b=$((16#${key_hex:$((i * 2)):2})); else b=0; fi
  ipad="$ipad$(printf '\\x%02x' $((b ^ 0x36)))"
  opad="$opad$(printf '\\x%02x' $((b ^ 0x5c)))"
  i=$((i + 1))
done
hex_escapes() {
  local hex=$1 out="" j=0
  while [ $j -lt ${#hex} ]; do
    out="$out\\x${hex:$j:2}"
    j=$((j + 2))
  done
  printf '%s' "$out"
}
hmac() { # the data on standard input
  local inner
  inner=$({ printf "$ipad"; cat; } | sha256)
  { printf "$opad"; printf "$(hex_escapes "$inner")"; } | sha256
}

# Moves a file into place without following a symlink at the destination.
if mv --version >/dev/null 2>&1; then
  place() { mv -f -T "$1" "$2"; }
else
  place() { mv -f -h "$1" "$2"; }
fi

clean_detail() { # standard input -> one line of at most 300 printable ASCII characters
  tr '\n\r\t' '   ' | tr -cd ' -~' | cut -c 1-300
}

# write_result ID OP OUTCOME REASON STARTED FINISHED DETAIL [FIELD...]
# Never replaces an existing result, and never writes through a symlink.
write_result() {
  local id=$1 op=$2 outcome=$3 reason=$4 started=$5 finished=$6 detail=$7
  shift 7
  local dest=$results/$id.res tmp mac f
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    journal "refused $id result-exists"
    return 1
  fi
  tmp=$(mktemp "$results/.res.XXXXXX") || return 1
  {
    printf 'lockstep-control-result 1\n'
    printf 'id %s\n' "$id"
    printf 'op %s\n' "$op"
    printf 'outcome %s\n' "$outcome"
    printf 'reason %s\n' "$reason"
    printf 'started %s\n' "$started"
    printf 'finished %s\n' "$finished"
    for f in "$@"; do printf 'field %s\n' "$f"; done
    printf 'detail %s\n' "$detail"
  } > "$tmp"
  mac=$(hmac < "$tmp")
  printf 'mac %s\n' "$mac" >> "$tmp"
  chmod 600 "$tmp"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    rm -f "$tmp"
    journal "refused $id result-exists"
    return 1
  fi
  place "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

refuse() { # ID OP REASON
  local now
  now=$(date +%s)
  journal "refused $1 $3"
  log "refused $1: $3"
  write_result "$1" "$2" refused "$3" "$now" "$now" "" || true
}

if [ -n "$instance" ]; then
  install=$root/.local/$instance-install
  service=lockstep-$instance
  service_cmd=("$root/scripts/service" --instance "$instance")
else
  install=$root/.local/install
  service=lockstep-service
  service_cmd=("$root/scripts/service")
fi

service_state() { # running | stopped | absent | unknown
  local s
  if s=$(docker container inspect --format '{{.State.Status}}' "$service" 2>/dev/null); then
    case $s in
      running) echo running ;;
      created | exited | dead | paused | restarting | removing) echo stopped ;;
      *) echo unknown ;;
    esac
  else
    echo absent
  fi
}

database_state() { # running | stopped | absent | unknown | not-managed
  local s
  if [ -n "$instance" ]; then
    echo not-managed
  elif s=$(docker container inspect --format '{{.State.Running}}' lockstep-postgres 2>/dev/null); then
    case $s in
      true) echo running ;;
      false) echo stopped ;;
      *) echo unknown ;;
    esac
  else
    echo absent
  fi
}

db_status_output() { # the installed CLI's `db status`, stdout and stderr
  "${service_cmd[@]}" cli db status < /dev/null 2>&1
}

answers_on() { # PORT
  curl -s -o /dev/null --max-time 3 "http://127.0.0.1:$1/api/health_check" 2>/dev/null
}

# The status operation (C-P3.1 L9, C-P3.2 M7). Its standard output is the result's
# field lines, one "name value" per line, then "detail TEXT" if there is something to say.
op_status() {
  local present=no commit=unknown dirty=unknown state server readiness=unknown
  local reason=unknown revision=unknown pending=unknown out code first word
  local health=no-answer port=unknown exit_code=none docker_server=unknown git_present=no
  [ -x "$install/bin/lockstep" ] && present=yes
  if [ -f "$install/VERSION" ]; then
    word=$(grep -E '^commit [0-9a-f]{40}$' "$install/VERSION" | head -n 1 | cut -d ' ' -f 2)
    [ -n "$word" ] && commit=$word
    if grep -qx 'dirty true' "$install/VERSION"; then dirty=true; fi
    if grep -qx 'dirty false' "$install/VERSION"; then dirty=false; fi
  fi
  state=$(service_state)
  server=$(database_state)
  if [ "$state" = running ]; then
    word=$(docker container inspect --format '{{range .Args}}{{.}} {{end}}' "$service" 2>/dev/null | sed -n 's/.*--port \([0-9][0-9]*\).*/\1/p')
    port=${word:-unknown}
    if answers_on "${word:-$service_port}"; then health=answers; fi
  elif [ "$state" = stopped ]; then
    word=$(docker container inspect --format '{{.State.ExitCode}}' "$service" 2>/dev/null)
    case $word in
      "" | *[!0-9]*) exit_code=unknown ;;
      *) exit_code=$word ;;
    esac
  fi
  word=$(docker version --format '{{.Server.Version}}' 2>/dev/null | head -n 1)
  case $word in
    "" | *[!A-Za-z0-9.:-]*) ;;
    *) [ ${#word} -le 40 ] && docker_server=$word ;;
  esac
  command -v git >/dev/null 2>&1 && git_present=yes
  if [ "$present" = yes ]; then
    out=$(db_status_output)
    code=$?
    first=$(printf '%s\n' "$out" | head -n 1)
    case $first in
      "readiness ready "[0-9]*) readiness=ready; reason=none ;;
      "readiness not_ready "*)
        readiness=not-ready
        word=$(printf '%s\n' "$first" | cut -d ' ' -f 3)
        case $word in
          "" | *[!abcdefghijklmnopqrstuvwxyz_]*) reason=unknown ;;
          *) reason=$word ;;
        esac
        ;;
    esac
    word=$(printf '%s\n' "$out" | grep -E '^revision ([0-9]{1,18}|none)$' | head -n 1 | cut -d ' ' -f 2)
    [ -n "$word" ] && revision=$word
    word=$(printf '%s\n' "$out" | grep -E '^pending [0-9]{1,18}$' | head -n 1 | cut -d ' ' -f 2)
    [ -n "$word" ] && pending=$word
    if [ "$readiness" = unknown ]; then
      printf 'detail %s\n' "$(printf '%s' "$out" | clean_detail)"
      [ "$code" = 0 ] || reason=unknown
    fi
  else
    reason=not-installed
  fi
  printf 'install.present %s\ninstall.commit %s\ninstall.dirty %s\n' "$present" "$commit" "$dirty"
  printf 'service.state %s\ndatabase.server %s\n' "$state" "$server"
  printf 'database.readiness %s\ndatabase.reason %s\n' "$readiness" "$reason"
  printf 'database.revision %s\ndatabase.pending %s\n' "$revision" "$pending"
  printf 'service.health %s\nservice.port %s\nservice.exitcode %s\n' "$health" "$port" "$exit_code"
  printf 'docker.server %s\ngit.present %s\n' "$docker_server" "$git_present"
  install_status_fields
  printf 'helper.protocol 1\n'
}

# ---------------------------------------------------------------- lifecycle (C-P3.2)

compatible() { # the installation is present and the schema matches it
  [ -x "$install/bin/lockstep" ] || return 1
  case $(db_status_output | head -n 1) in
    "readiness ready "[0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Checks the expected state (M2, M4). Prints a refusal code, or nothing if the operation may run.
lifecycle_refusal() { # OP
  local svc db
  svc=$(service_state)
  case $1 in
    service-start)
      case $svc in stopped | absent) ;; *) echo state-changed; return ;; esac
      compatible || echo not-compatible
      ;;
    service-stop)
      [ "$svc" = running ] || echo state-changed
      ;;
    service-restart)
      [ "$svc" = running ] || { echo state-changed; return; }
      compatible || echo not-compatible
      ;;
    database-start)
      [ -z "$instance" ] || { echo not-managed; return; }
      db=$(database_state)
      case $db in stopped | absent) ;; *) echo state-changed ;; esac
      ;;
    database-stop)
      [ -z "$instance" ] || { echo not-managed; return; }
      db=$(database_state)
      if [ "$svc" = running ] || [ "$db" != running ]; then echo state-changed; fi
      ;;
  esac
}

# The fixed commands (M3). Everything they print goes to standard output.
lifecycle_action() {
  case $lifecycle_op in
    service-start)
      if [ "$(service_state)" = stopped ]; then
        "${service_cmd[@]}" restart --port "$service_port" < /dev/null 2>&1
      else
        "${service_cmd[@]}" start --port "$service_port" < /dev/null 2>&1
      fi
      ;;
    service-stop) "${service_cmd[@]}" stop < /dev/null 2>&1 ;;
    service-restart) "${service_cmd[@]}" restart --port "$service_port" < /dev/null 2>&1 ;;
    database-start) "$root/scripts/db" up < /dev/null 2>&1 ;;
    database-stop) "$root/scripts/db" down < /dev/null 2>&1 ;;
  esac
}

# Observes the result again (M4): ok only if the intended state now holds.
lifecycle_holds() { # OP
  case $1 in
    service-start | service-restart) [ "$(service_state)" = running ] && answers_on "$service_port" ;;
    service-stop) [ "$(service_state)" != running ] ;;
    database-start) [ "$(database_state)" = running ] ;;
    database-stop) [ "$(database_state)" != running ] ;;
  esac
}

execute_lifecycle() { # ID OP
  local id=$1 op=$2 started finished out detail refusal
  refusal=$(lifecycle_refusal "$op")
  if [ -n "$refusal" ]; then
    refuse "$id" "$op" "$refusal"
    return
  fi
  started=$(date +%s)
  journal "start $id $op"
  out=$helper/.out.$id
  lifecycle_op=$op
  run_bounded "$out" lifecycle_action
  if [ "$run_outcome" = ok ] && ! lifecycle_holds "$op"; then
    run_outcome=failed
  fi
  finished=$(date +%s)
  detail=""
  if [ "$run_outcome" != ok ]; then
    detail=$(cat "$out" "$out.err" 2>/dev/null | tail -c 600 | clean_detail)
    [ -n "$detail" ] || detail="the operation did not reach the intended state"
  fi
  rm -f "$out" "$out.err"
  write_result "$id" "$op" "$run_outcome" - "$started" "$finished" "$detail" || true
  journal "end $id $run_outcome"
  log "$op $id: $run_outcome"
}

stopping=0
trap 'stopping=1' TERM INT

# Runs one operation in its own process group, bounded by the timeout.
# Sets run_outcome to ok, failed or timed-out; the output is in $1.
run_bounded() { # OUTPUT-FILE FUNCTION [LIMIT-SECONDS]
  local out=$1 fn=$2 limit=${3:-$timeout} pid watchdog marker rc
  marker=$helper/.timeout.$$
  rm -f "$marker"
  set -m
  ( "$fn" ) > "$out" 2> "$out.err" &
  pid=$!
  set +m
  (
    sleep "$limit"
    : > "$marker"
    kill -TERM -- "-$pid" 2>/dev/null
    sleep 2
    kill -KILL -- "-$pid" 2>/dev/null
  ) &
  watchdog=$!
  while :; do
    wait "$pid"
    rc=$?
    if [ "$rc" -gt 128 ] && kill -0 "$pid" 2>/dev/null; then continue; fi
    break
  done
  kill "$watchdog" 2>/dev/null
  pkill -P "$watchdog" 2>/dev/null
  wait "$watchdog" 2>/dev/null
  if [ -e "$marker" ]; then
    rm -f "$marker"
    run_outcome=timed-out
  elif [ "$rc" = 0 ]; then
    run_outcome=ok
  else
    run_outcome=failed
  fi
}

execute() { # ID OP
  local id=$1 op=$2 started finished out fields detail line
  started=$(date +%s)
  journal "start $id $op"
  out=$helper/.out.$id
  case $op in
    status) run_bounded "$out" op_status ;;
  esac
  finished=$(date +%s)
  fields=()
  detail=""
  if [ "$run_outcome" = ok ]; then
    while IFS= read -r line; do
      case $line in
        "detail "*) detail=${line#detail } ;;
        *) fields+=("$line") ;;
      esac
    done < "$out"
  else
    detail=$(clean_detail < "$out.err")
  fi
  rm -f "$out" "$out.err"
  if [ ${#fields[@]} -gt 0 ]; then
    write_result "$id" "$op" "$run_outcome" - "$started" "$finished" "$detail" "${fields[@]}" || true
  else
    write_result "$id" "$op" "$run_outcome" - "$started" "$finished" "$detail" || true
  fi
  journal "end $id $run_outcome"
  log "$op $id: $run_outcome"
}

# ---------------------------------------------------------------- install and upgrade (C-P3.3)

if [ -n "$instance" ]; then
  staging_rel=.local/$instance-staging-install
  backups=$root/.local/$instance-backups
  config_file=$root/.local/config/lockstep-$instance.json
  host_config=$config_file
else
  staging_rel=.local/staging-install
  backups=$root/.local/backups
  config_file=$root/.local/config/lockstep.json
  host_config=$root/.local/config/lockstep-host.json
fi
staging=$root/$staging_rel
record=$helper/upgrade.current

config_value() { # KEY -> the value of "KEY":"..." in the database configuration, if plain
  local v
  v=$(sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p" "$config_file" 2>/dev/null | head -n 1)
  case $v in
    "" | *[!abcdefghijklmnopqrstuvwxyz0123456789_]*) echo "" ;;
    *) echo "$v" ;;
  esac
}
db_name=$(config_value name)
db_name=${db_name:-lockstep}
db_user=$(config_value username)
db_user=${db_user:-lockstep}

long_timeout=${LOCKSTEP_HELPER_LONG_TIMEOUT:-1800}
case $long_timeout in
  "" | *[!0-9]*) long_timeout=1800 ;;
esac
if [ "$long_timeout" -lt 1 ] || [ "$long_timeout" -gt 7200 ]; then long_timeout=1800; fi

# The scripts/service command for the staged candidate (the same instance's config).
staged_service() {
  if [ -n "$instance" ]; then
    LOCKSTEP_SERVICE_INSTALL_DIR=$staging_rel LOCKSTEP_SERVICE_CONFIG=.local/config/lockstep-$instance.json \
      LOCKSTEP_SERVICE_NAME=lockstep-$instance "$root/scripts/service" "$@"
  else
    LOCKSTEP_SERVICE_INSTALL_DIR=$staging_rel "$root/scripts/service" "$@"
  fi
}

candidate_digest() { # 16 hex characters of the staged binary's SHA-256, or nothing
  [ -x "$staging/bin/lockstep" ] || return 0
  sha256 < "$staging/bin/lockstep" | cut -c 1-16
}

# The upgrade record: key/value lines, rewritten whole (U3, U6).
record_get() { # KEY
  sed -n "s/^$1 //p" "$record" 2>/dev/null | head -n 1
}
record_set() { # KEY VALUE ... (all other keys kept)
  local tmp key
  tmp=$(mktemp "$helper/.record.XXXXXX")
  if [ -f "$record" ]; then cp "$record" "$tmp"; fi
  while [ $# -ge 2 ]; do
    key=$1
    grep -v "^$key " "$tmp" > "$tmp.new" || true
    printf '%s %s\n' "$key" "$2" >> "$tmp.new"
    mv "$tmp.new" "$tmp"
    shift 2
  done
  mv -f "$tmp" "$record"
}
upgrade_state() { # none | recovery-needed | interrupted
  case $(record_get status) in
    recovery-needed) echo recovery-needed ;;
    interrupted) echo interrupted ;;
    *) echo none ;;
  esac
}

# Fields for the status operation (U8).
install_status_fields() {
  local digest commit pending=unknown out word
  digest=$(candidate_digest)
  if [ -n "$digest" ]; then
    commit=$(grep -E '^commit [0-9a-f]{40}$' "$staging/VERSION" 2>/dev/null | head -n 1 | cut -d ' ' -f 2)
    out=$(staged_service cli db status < /dev/null 2>&1)
    word=$(printf '%s\n' "$out" | grep -E '^pending [0-9]{1,18}$' | head -n 1 | cut -d ' ' -f 2)
    [ -n "$word" ] && pending=$word
    printf 'candidate.present yes\ncandidate.commit %s\ncandidate.digest %s\ncandidate.pending %s\n' "${commit:-unknown}" "$digest" "$pending"
  else
    printf 'candidate.present no\n'
  fi
  printf 'upgrade.state %s\n' "$(upgrade_state)"
  if [ "$(upgrade_state)" != none ]; then
    printf 'upgrade.id %s\nupgrade.step %s\n' "$(record_get id)" "$(record_get step)"
  fi
  if [ -x "$install.previous/bin/lockstep" ]; then printf 'previous.present yes\n'; else printf 'previous.present no\n'; fi
}

install_refusal() { # OP EXPECT
  local digest
  digest=$(candidate_digest)
  case $1 in
    prepare-candidate)
      case $2 in
        candidate-none) [ -z "$digest" ] || { echo state-changed; return; } ;;
        *) [ "$2" = "candidate-$digest" ] || { echo state-changed; return; } ;;
      esac
      if ! command -v git >/dev/null 2>&1 || [ -n "$(git -C "$root" status --porcelain 2>/dev/null)" ]; then
        echo dirty-checkout
      fi
      ;;
    apply-candidate)
      [ -n "$digest" ] && [ "$2" = "candidate-$digest" ] || { echo state-changed; return; }
      [ "$(upgrade_state)" = none ] || { echo recovery-needed; return; }
      case $(staged_service cli db status < /dev/null 2>&1 | head -n 1) in
        "readiness not_ready schema_invalid unknown_applied_migration"*) echo database-ahead ;;
      esac
      ;;
    restore-previous)
      [ "$(upgrade_state)" != none ] && [ "$2" = "recovery-$(record_get id)" ] || echo state-changed
      ;;
  esac
}

prepare_action() {
  rm -rf "$staging"
  if ! LOCKSTEP_SERVICE_INSTALL_DIR=$staging_rel "$root/scripts/service" install < /dev/null 2>&1; then
    rm -rf "$staging"
    return 1
  fi
  [ -x "$staging/bin/lockstep" ] || { rm -rf "$staging"; return 1; }
}

verify_backup() { # FILE
  local file=$1 want got
  [ -s "$file" ] || { echo "the backup file is empty or missing"; return 1; }
  want=$(cut -d ' ' -f 1 "$file.sha256" 2>/dev/null)
  got=$(sha256 < "$file")
  [ -n "$want" ] && [ "$want" = "$got" ] || { echo "the backup's digest does not match"; return 1; }
  docker exec -i lockstep-postgres pg_restore --list < "$file" > /dev/null 2>&1 || { echo "the backup cannot be read back"; return 1; }
}

# The migration with the candidate binary, the verified backup mounted read-only at a fixed path.
migrate_with_candidate() { # BACKUP-FILE (empty: none needed)
  local -a args=(--network host
    --volume "$staging:/opt/lockstep:ro"
    --volume "$host_config:/etc/lockstep/lockstep.json:ro"
    --env LOCKSTEP_CONFIG=/etc/lockstep/lockstep.json)
  if [ -n "$1" ]; then
    args+=(--volume "$1:/backup/$(basename "$1"):ro")
    docker run --rm "${args[@]}" lockstep-dev:p1 /opt/lockstep/bin/lockstep db migrate --backup "/backup/$(basename "$1")" < /dev/null 2>&1
  else
    docker run --rm "${args[@]}" lockstep-dev:p1 /opt/lockstep/bin/lockstep db migrate < /dev/null 2>&1
  fi
}

ready_and_answering() {
  case $(db_status_output | head -n 1) in
    "readiness ready "[0-9]*) answers_on "$service_port" ;;
    *) return 1 ;;
  esac
}

# U3: the upgrade, step by step; each step is in the record before it starts.
apply_action() {
  local backup="" status_line
  status_line=$(staged_service cli db status < /dev/null 2>&1 | grep -E '^revision ' | head -n 1)
  if [ -x "$install/bin/lockstep" ] || [ "$status_line" != "revision none" ]; then
    record_set step backup
    mkdir -p "$backups"
    backup=$(LOCKSTEP_DB_NAME=$db_name LOCKSTEP_DB_USER=$db_user LOCKSTEP_BACKUP_DIR=$backups "$root/scripts/db" backup < /dev/null 2>&1 | tail -n 1)
    case $backup in
      /*) ;;
      *) echo "the backup could not be created: $backup"; record_set status failed; return 1 ;;
    esac
    verify_backup "$backup" || { record_set status failed; return 1; }
    record_set backup "$backup"
  fi
  record_set step stop
  if [ "$(service_state)" != absent ]; then
    "${service_cmd[@]}" stop < /dev/null 2>&1 || { record_set status failed; "${service_cmd[@]}" start --port "$service_port" < /dev/null 2>&1; return 1; }
  fi
  record_set step migrate migrated attempted
  if ! migrate_with_candidate "$backup"; then
    record_set status recovery-needed
    return 1
  fi
  record_set step activate migrated yes
  rm -rf "$install.previous"
  if [ -d "$install" ]; then mv "$install" "$install.previous" || { record_set status recovery-needed; return 1; }; fi
  mv "$staging" "$install" || { record_set status recovery-needed; return 1; }
  record_set activated yes step start
  "${service_cmd[@]}" start --port "$service_port" < /dev/null 2>&1 || { record_set status recovery-needed; return 1; }
  record_set step verify
  ready_and_answering || { echo "the new version did not become ready and answer"; record_set status recovery-needed; return 1; }
  record_set status done step done
}

# U4: put the database and the previous version back.
restore_action() {
  local backup migrated activated
  backup=$(record_get backup)
  migrated=$(record_get migrated)
  activated=$(record_get activated)
  if [ "$(service_state)" != absent ]; then "${service_cmd[@]}" stop < /dev/null 2>&1 || true; fi
  if [ -n "$migrated" ]; then
    [ -n "$backup" ] || { echo "there is no backup to restore"; return 1; }
    verify_backup "$backup" || return 1
    docker exec lockstep-postgres psql -q -U "$db_user" -d "$db_name" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' < /dev/null 2>&1 || return 1
    LOCKSTEP_DB_NAME=$db_name LOCKSTEP_DB_USER=$db_user "$root/scripts/db" restore "$backup" < /dev/null 2>&1 || return 1
  fi
  if [ "$activated" = yes ] && [ -x "$install.previous/bin/lockstep" ]; then
    rm -rf "$install"
    mv "$install.previous" "$install" || return 1
  fi
  "${service_cmd[@]}" start --port "$service_port" < /dev/null 2>&1 || return 1
  ready_and_answering || { echo "the previous version did not become ready and answer"; return 1; }
}

execute_install() { # ID OP EXPECT
  local id=$1 op=$2 expect=$3 started finished out detail refusal
  refusal=$(install_refusal "$op" "$expect")
  if [ -n "$refusal" ]; then
    refuse "$id" "$op" "$refusal"
    return
  fi
  started=$(date +%s)
  journal "start $id $op"
  out=$helper/.out.$id
  case $op in
    prepare-candidate) run_bounded "$out" prepare_action "$long_timeout" ;;
    apply-candidate)
      printf 'id %s\nstatus running\nstep check\n' "$id" > "$record"
      run_bounded "$out" apply_action "$long_timeout"
      if [ "$run_outcome" != ok ]; then
        case $(record_get status) in
          running) [ "$(record_get migrated)" = "" ] && record_set status failed || record_set status recovery-needed ;;
        esac
      fi
      ;;
    restore-previous)
      run_bounded "$out" restore_action "$long_timeout"
      [ "$run_outcome" = ok ] && record_set status restored step done
      ;;
  esac
  finished=$(date +%s)
  detail=""
  if [ "$run_outcome" != ok ]; then
    detail=$(cat "$out" "$out.err" 2>/dev/null | tail -c 600 | clean_detail)
    [ -n "$detail" ] || detail="the operation did not reach the intended state"
  fi
  rm -f "$out" "$out.err"
  write_result "$id" "$op" "$run_outcome" - "$started" "$finished" "$detail" || true
  journal "end $id $run_outcome"
  log "$op $id: $run_outcome"
}

# ---------------------------------------------------------------- hand-over (C-P3.4 A3)

running_port() { # the port the running service was started with, else the fixed one
  local p
  p=$(docker container inspect --format '{{range .Args}}{{.}} {{end}}' "$service" 2>/dev/null | sed -n 's/.*--port \([0-9][0-9]*\).*/\1/p')
  echo "${p:-$service_port}"
}

# Issues a one-time application sign-in with the fixed CLI command and leaves it
# only in pane/handover/<id> (0600). Nothing it prints contains the token.
session_action() {
  local port out token tmp dest re
  port=$(running_port)
  out=$("${service_cmd[@]}" cli operator sign-in --port "$port" < /dev/null 2>/dev/null) || { echo "the sign-in could not be issued"; return 1; }
  re='^http://127\.0\.0\.1:[0-9]+/operator/sign-in\?token=([A-Za-z0-9_-]{43})$'
  [[ $out =~ $re ]] || { out=""; echo "the sign-in command answered unexpectedly"; return 1; }
  token=${BASH_REMATCH[1]}
  out=""
  dest=$pane/handover/$session_id
  mkdir -p "$pane/handover"
  chmod 700 "$pane/handover"
  if [ -e "$dest" ] || [ -L "$dest" ]; then token=""; echo "a hand-over already exists"; return 1; fi
  tmp=$(mktemp "$pane/handover/.h.XXXXXX")
  printf 'port %s\ntoken %s\n' "$port" "$token" > "$tmp"
  token=""
  chmod 600 "$tmp"
  place "$tmp" "$dest" || { rm -f "$tmp"; return 1; }
}

execute_session() { # ID
  local id=$1 started finished out detail
  if [ "$(service_state)" != running ] || ! answers_on "$(running_port)"; then
    refuse "$id" open-application state-changed
    return
  fi
  started=$(date +%s)
  journal "start $id open-application"
  out=$helper/.out.$id
  session_id=$id
  run_bounded "$out" session_action
  finished=$(date +%s)
  detail=""
  [ "$run_outcome" = ok ] || detail=$(cat "$out" "$out.err" 2>/dev/null | tail -c 300 | clean_detail)
  rm -f "$out" "$out.err"
  write_result "$id" open-application "$run_outcome" - "$started" "$finished" "$detail" "service.port $(running_port)" || true
  journal "end $id $run_outcome"
  log "open-application $id: $run_outcome"
}

# ---------------------------------------------------------------- project folders (C-P3.5 J5, J6)

# The folders the service may see: "rw PATH" (the projects folder, first, only
# with --projects) and up to 15 "ro PATH" lines, canonical absolute paths. The
# pane gets a copy to show; scripts/service mounts what the list names.
folders_file=$helper/folders
export LOCKSTEP_SERVICE_FOLDERS=$folders_file
home_real=$(cd -P -- "${HOME:-/nonexistent}" 2>/dev/null && pwd -P || true)

plain_path() { # PATH: absolute, printable ASCII, no ':' or ',', no empty, '.' or '..' segment
  case $1 in
    /*) ;;
    *) return 1 ;;
  esac
  case $1 in
    / | *:* | *,* | */ | *//* | */./* | */../* | */. | */..) return 1 ;;
  esac
  [[ ! $1 =~ [^\ -~] ]]
}

publish_folders() {
  local tmp
  tmp=$(mktemp "$pane/.folders.XXXXXX") || return 1
  cat "$folders_file" > "$tmp"
  chmod 600 "$tmp"
  place "$tmp" "$pane/folders" || rm -f "$tmp"
}

# Writes the list at start: the projects folder (made if missing) and the added folders kept.
init_folders() {
  local tmp line real=""
  if [ -n "$projects" ]; then
    mkdir -p -- "$projects" 2>/dev/null
    real=$(cd -P -- "$projects" 2>/dev/null && pwd -P || true)
    if [ -z "$real" ] || ! plain_path "$real"; then
      log "the projects folder $projects cannot be used; no folder for new projects"
      real=""
    fi
  fi
  tmp=$(mktemp "$helper/.folders.XXXXXX") || fatal "the folder list cannot be written"
  {
    [ -n "$real" ] && printf 'rw %s\n' "$real"
    if [ -f "$folders_file" ]; then
      while IFS= read -r line; do
        case $line in
          "ro /"*) plain_path "${line#ro }" && printf '%s\n' "$line" ;;
        esac
      done < "$folders_file"
    fi
  } > "$tmp"
  chmod 600 "$tmp"
  place "$tmp" "$folders_file" || fatal "the folder list cannot be written"
  publish_folders || log "the folder list could not be given to the pane"
}

folders_digest() {
  printf 'folders-%s' "$(sha256 < "$folders_file" | cut -c 1-16)"
}

# Checks the folder once, in this shell (C-C.R1 R6): sets folder_refusal_code (empty
# when the folder may be added) and folder_real (the one resolution that is written).
check_folder() { # PATH
  local path=$1 line listed added=0
  folder_refusal_code=""
  folder_real=""
  plain_path "$path" || { folder_refusal_code=unusable-path; return; }
  [ -e "$path" ] || { folder_refusal_code=folder-missing; return; }
  [ -d "$path" ] || { folder_refusal_code=not-a-folder; return; }
  folder_real=$(cd -P -- "$path" 2>/dev/null && pwd -P || true)
  [ -n "$folder_real" ] || { folder_refusal_code=folder-missing; return; }
  plain_path "$folder_real" || { folder_refusal_code=unusable-path; return; }
  [ -n "$home_real" ] || { folder_refusal_code=outside-home; return; }
  [ "$folder_real" != "$home_real" ] || { folder_refusal_code=home-folder; return; }
  case $folder_real in
    "$home_real"/*) ;;
    *) folder_refusal_code=outside-home; return ;;
  esac
  case "$folder_real/" in
    "$root"/*) folder_refusal_code=inside-lockstep; return ;;
  esac
  case "$root/" in
    "$folder_real"/*) folder_refusal_code=inside-lockstep; return ;;
  esac
  while IFS= read -r line; do
    listed=${line#* }
    [ "${line%% *}" = ro ] && added=$((added + 1))
    [ "$folder_real" != "$listed" ] || { folder_refusal_code=already-listed; return; }
    case $folder_real in "$listed"/*) folder_refusal_code=overlaps-listed; return ;; esac
    case $listed in "$folder_real"/*) folder_refusal_code=overlaps-listed; return ;; esac
  done < "$folders_file"
  [ "$added" -lt 15 ] || folder_refusal_code=list-full
}

folder_restart() {
  "${service_cmd[@]}" restart --port "$(running_port)" < /dev/null 2>&1
}

execute_folder() { # ID EXPECT PATH
  local id=$1 expect=$2 path=$3 started finished refusal tmp restart=not-needed out
  if [ "$expect" != "$(folders_digest)" ]; then
    refuse "$id" add-folder state-changed
    return
  fi
  check_folder "$path"
  refusal=$folder_refusal_code
  if [ -n "$refusal" ]; then
    refuse "$id" add-folder "$refusal"
    return
  fi
  started=$(date +%s)
  journal "start $id add-folder"
  tmp=$(mktemp "$helper/.folders.XXXXXX")
  { cat "$folders_file"; printf 'ro %s\n' "$folder_real"; } > "$tmp"
  chmod 600 "$tmp"
  place "$tmp" "$folders_file" || { rm -f "$tmp"; refuse "$id" add-folder unusable-path; return; }
  publish_folders || log "the folder list could not be given to the pane"
  log "added the folder $folder_real"
  if [ "$(service_state)" = running ]; then
    out=$helper/.out.$id
    run_bounded "$out" folder_restart
    if [ "$run_outcome" = ok ] && [ "$(service_state)" = running ] && answers_on "$(running_port)"; then restart=ok; else restart=failed; fi
    rm -f "$out" "$out.err"
  fi
  finished=$(date +%s)
  write_result "$id" add-folder ok - "$started" "$finished" "" "service.restart $restart" || true
  journal "end $id ok"
  log "add-folder $id: ok (restart $restart)"
}

re_folder_header='^lockstep-folder-request ([^ ]+)$'
re_path='^path (/.*)$'
re_header='^lockstep-control-request ([^ ]+)$'
re_session_header='^lockstep-session-request ([^ ]+)$'
re_install_header='^lockstep-install-request ([^ ]+)$'
re_lifecycle_header='^lockstep-lifecycle-request ([^ ]+)$'
re_id='^id ([0-9a-f]{32})$'
re_issued='^issued ([0-9]{1,18})$'
re_op='^op ([^ ].*)$'
re_expect='^expect ([^ ].*)$'
re_mac='^mac ([0-9a-f]{64})$'

# Checks one request file (C-P3.1 §4, C-P3.2 §3) and runs it if every check passes.
# A .req file is a status request; a .lreq file is a lifecycle request.
handle() { # NAME
  local name=$1 path=$requests/$1 id kind size lines line mac version issued op expect now header count folder_path=""
  case $name in
    .*) return ;;
  esac
  if [[ $name =~ ^[0-9a-f]{32}\.req$ ]]; then
    kind=status
    id=${name%.req}
    header=$re_header
  elif [[ $name =~ ^[0-9a-f]{32}\.lreq$ ]]; then
    kind=lifecycle
    id=${name%.lreq}
    header=$re_lifecycle_header
  elif [[ $name =~ ^[0-9a-f]{32}\.ireq$ ]]; then
    kind=install
    id=${name%.ireq}
    header=$re_install_header
  elif [[ $name =~ ^[0-9a-f]{32}\.sreq$ ]]; then
    kind=session
    id=${name%.sreq}
    header=$re_session_header
  elif [[ $name =~ ^[0-9a-f]{32}\.freq$ ]]; then
    kind=folder
    id=${name%.freq}
    header=$re_folder_header
  else
    rm -f -- "$path"
    log "removed a file that is not a request: name not allowed"
    return
  fi
  if [ -L "$path" ]; then rm -f -- "$path"; refuse "$id" unknown not-regular-file; return; fi
  if [ ! -f "$path" ]; then rmdir -- "$path" 2>/dev/null; refuse "$id" unknown not-regular-file; return; fi
  if [ ! -O "$path" ]; then rm -f -- "$path"; refuse "$id" unknown not-owner; return; fi
  case $(mode_of "$path") in
    *00) ;;
    *) rm -f -- "$path"; refuse "$id" unknown bad-permissions; return ;;
  esac
  size=$(wc -c < "$path" | tr -d ' ')
  if [ "$size" -gt 1024 ]; then rm -f -- "$path"; refuse "$id" unknown too-large; return; fi
  # Printable ASCII lines, each ending in a newline, exactly six of them (seven for a
  # folder request, whose last body line is the path), the MAC last.
  if grep -q '[^ -~]' "$path" || [ "$(tail -c 1 "$path" | wc -l | tr -d ' ')" != 1 ]; then
    rm -f -- "$path"; refuse "$id" unknown malformed; return
  fi
  count=6
  [ "$kind" = folder ] && count=7
  lines=()
  while IFS= read -r line; do lines+=("$line"); done < "$path"
  if [ ${#lines[@]} -ne $count ] || [[ ! ${lines[$((count - 1))]} =~ $re_mac ]]; then
    rm -f -- "$path"; refuse "$id" unknown malformed; return
  fi
  mac=${BASH_REMATCH[1]}
  if [ "$(head -n $((count - 1)) "$path" | hmac)" != "$mac" ]; then
    rm -f -- "$path"; refuse "$id" unknown bad-mac; return
  fi
  rm -f -- "$path"
  if [[ ! ${lines[0]} =~ $header ]]; then refuse "$id" unknown malformed; return; fi
  version=${BASH_REMATCH[1]}
  [ "$version" = 1 ] || { refuse "$id" unknown bad-version; return; }
  if [[ ! ${lines[1]} =~ $re_id ]] || [ "${BASH_REMATCH[1]}" != "$id" ]; then refuse "$id" unknown malformed; return; fi
  if [[ ! ${lines[2]} =~ $re_issued ]]; then refuse "$id" unknown malformed; return; fi
  issued=${BASH_REMATCH[1]}
  if [[ ! ${lines[3]} =~ $re_op ]]; then refuse "$id" unknown malformed; return; fi
  op=${BASH_REMATCH[1]}
  if [[ ! ${lines[4]} =~ $re_expect ]]; then refuse "$id" unknown malformed; return; fi
  expect=${BASH_REMATCH[1]}
  if [ "$kind" = status ]; then
    case $op in
      status) ;;
      *) refuse "$id" unknown unknown-op; return ;;
    esac
    case "$op $expect" in
      "status any") ;;
      *) refuse "$id" "$op" bad-expect; return ;;
    esac
  elif [ "$kind" = lifecycle ]; then
    case $op in
      service-start | service-stop | service-restart | database-start | database-stop) ;;
      *) refuse "$id" unknown unknown-op; return ;;
    esac
    case "$op $expect" in
      "service-start not-running" | "service-stop running" | "service-restart running" | \
        "database-start not-running" | "database-stop service-not-running") ;;
      *) refuse "$id" "$op" bad-expect; return ;;
    esac
  elif [ "$kind" = session ]; then
    [ "$op" = open-application ] || { refuse "$id" unknown unknown-op; return; }
    [ "$expect" = service-running ] || { refuse "$id" "$op" bad-expect; return; }
  elif [ "$kind" = folder ]; then
    [ "$op" = add-folder ] || { refuse "$id" unknown unknown-op; return; }
    [[ $expect =~ ^folders-[0-9a-f]{16}$ ]] || { refuse "$id" "$op" bad-expect; return; }
    if [[ ! ${lines[5]} =~ $re_path ]]; then refuse "$id" "$op" unusable-path; return; fi
    folder_path=${BASH_REMATCH[1]}
  else
    case $op in
      prepare-candidate | apply-candidate | restore-previous) ;;
      *) refuse "$id" unknown unknown-op; return ;;
    esac
    if [[ ! "$op $expect" =~ ^(prepare-candidate\ candidate-(none|[0-9a-f]{16})|apply-candidate\ candidate-[0-9a-f]{16}|restore-previous\ recovery-[0-9a-f]{32})$ ]]; then
      refuse "$id" "$op" bad-expect
      return
    fi
  fi
  if grep -qxF "$id" "$helper/seen" 2>/dev/null; then
    journal "refused $id replayed"
    log "refused $id: replayed"
    return
  fi
  now=$(date +%s)
  if [ "$issued" -lt $((now - 120)) ] || [ "$issued" -gt $((now + 10)) ]; then
    refuse "$id" "$op" stale
    return
  fi
  echo "$id" >> "$helper/seen"
  case $kind in
    status) execute "$id" "$op" ;;
    lifecycle) execute_lifecycle "$id" "$op" ;;
    install) execute_install "$id" "$op" "$expect" ;;
    session) execute_session "$id" ;;
    folder) execute_folder "$id" "$expect" "$folder_path" ;;
  esac
}

# An upgrade that was running when the helper stopped is interrupted at its step (U6).
if [ "$(record_get status)" = running ]; then
  record_set status interrupted
  log "the upgrade $(record_get id) was interrupted at step $(record_get step)"
fi

# An operation that started and never ended was interrupted (the helper stopped).
if [ -f "$helper/journal" ]; then
  awk '$2 == "start" { open[$3] = $4 } $2 == "end" { delete open[$3] } END { for (id in open) print id, open[id] }' "$helper/journal" |
    while read -r id op; do
      case $id in *[!0123456789abcdef]*) continue ;; esac
      now=$(date +%s)
      write_result "$id" "$op" interrupted - "$now" "$now" "the helper stopped while this ran" || true
      journal "end $id interrupted"
      log "$op $id: interrupted"
    done
fi

init_folders
log "started (pid $$, protocol 1, timeout ${timeout}s${instance:+, instance $instance})"
warned=""
while [ "$stopping" = 0 ]; do
  if private_dir "$pane" && private_dir "$requests" && [ -d "$results" ] && [ ! -L "$results" ]; then
    warned=""
    while IFS= read -r name; do
      [ "$stopping" = 0 ] || break
      [ -n "$name" ] && handle "$name"
    done <<EOF
$(ls -1tr "$requests" 2>/dev/null)
EOF
  elif [ -z "$warned" ]; then
    warned=yes
    log "the request or result directory is missing, a symlink or not private; nothing is read"
  fi
  sleep 0.2
done
log "stopped"
