#!/usr/bin/env python3
# Requests sent straight to the egress proxy by scripts/lib/check-live-proxy
# (contract C-P4.L.R1; test only), as raw bytes, so that what the proxy checks
# and what it forwards can be told apart. One line per probe: "NAME STATUS CODE".
#
#   live-proxy-probe MODEL EFFORT PROBE...
import http.client
import json
import sys


def send(name, body):
    try:
        c = http.client.HTTPConnection("lockstep-egress", 8080, timeout=20)
        c.putrequest("POST", "/v1/messages?beta=true", skip_accept_encoding=True)
        c.putheader("content-type", "application/json")
        c.putheader("content-length", str(len(body)))
        c.endheaders()
        c.send(body)
        r = c.getresponse()
        text = r.read(65536)
        code = "-"
        try:
            parsed = json.loads(text)
            if isinstance(parsed, dict) and isinstance(parsed.get("error"), dict):
                code = parsed["error"].get("message", "-")
        except ValueError:
            pass
        print(name, r.status, code, flush=True)
    except OSError as e:
        print(name, "error", type(e).__name__, flush=True)


def main():
    model, effort = sys.argv[1], sys.argv[2]
    other = "claude-opus-5-5" if model != "claude-opus-5-5" else "claude-haiku-5-5"
    base = ('"max_tokens":100,"stream":true,"output_config":{"effort":"%s"},'
            '"messages":[{"role":"user","content":"hello"}]' % effort)
    for probe in sys.argv[3:]:
        if probe == "valid":
            send("valid", ('{"model":"%s",%s}' % (model, base)).encode())
        elif probe == "spaced":
            # Valid, written loosely: what reaches the upstream shows whether the checked document is what is sent.
            send("spaced", ('{ "model" : "%s" , %s }' % (model, base)).encode())
        elif probe == "duplicate-model":
            # The checked copy keeps the last value; a provider might keep the first.
            send("duplicate-model", ('{"model":"%s","model":"%s",%s}' % (other, model, base)).encode())
        elif probe == "duplicate-tools":
            send("duplicate-tools", ('{"model":"%s",%s,"tools":[{"type":"web_fetch_20250910","name":"web_fetch"}],"tools":[]}'
                                     % (model, base)).encode())
        elif probe == "price-field":
            send("price-field", ('{"model":"%s",%s,"inference_geo":"us"}' % (model, base)).encode())
        elif probe == "service-tier":
            send("service-tier", ('{"model":"%s",%s,"service_tier":"priority"}' % (model, base)).encode())
        elif probe == "no-effort":
            send("no-effort", ('{"model":"%s","max_tokens":100,"stream":true,"messages":[{"role":"user","content":"hello"}]}'
                               % model).encode())
        elif probe == "deep":
            send("deep", ('{"model":"%s",%s,"metadata":%s}' % (model, base, "[" * 100000 + "]" * 100000)).encode())
    return 0


if __name__ == "__main__":
    sys.exit(main())
