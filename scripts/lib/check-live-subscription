#!/usr/bin/env bash
# Subscription-backed live runs (contract C-P4.L.S): the real helper in its
# explicit offline-test mode, the real Claude Code CLI, a stand-in upstream that
# records how each request authenticates (scripts/lib/live-standin-headers), on an
# internal network. Synthetic tokens only; no provider contacted. Needs Docker and
# the provider image. Results: .local/evidence/live-subscription-<stamp>/
#
#   S1  a subscription configuration and token: the upstream gets the token as
#       Authorization: Bearer (never x-api-key) with the oauth feature; the role's
#       container sees only a placeholder; a token of the other kind is refused,
#       credential-mode-mismatch, nothing sent
#   S2  usage, not dollars: micro-USD 0, tokens counted; the token limit stops a run
#   S3  the CLI without --bare: the repository's CLAUDE.md, skills, agents,
#       commands and .mcp.json reach no request; only Read, Edit, Bash; only
#       /v1/messages; a development run completes with its answer
set -euo pipefail
cd "$(dirname "$0")/../.."
root=$PWD

stamp=$(date -u +%Y%m%dt%H%M%Sz)
work=$root/.local/evidence/live-subscription-$stamp
mkdir -p "$work/agent"
results=$work/results.txt
: > "$results"
failures=0
net=lockstep-sub-$stamp
agent=lockstep-sub-agent-$stamp
instance=p4lsub
image=lockstep-provider:claude-2.1.312
model=claude-sonnet-5-5
effort=medium
state=$root/.local/live-subscription-$stamp
token=sk-ant-oat01-test-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
apikey=sk-ant-test-$(head -c 20 /dev/urandom | od -An -tx1 | tr -d ' \n')
markers=MARKER-CLAUDEMD-7f3a,MARKER-SKILL-7f3a,MARKER-AGENT-7f3a,MARKER-COMMAND-7f3a,MARKER-MCP-7f3a

record() { # STATUS DESCRIPTION
  printf '%s %s\n' "$1" "$2" | tee -a "$results"
  if [ "$1" != PASS ]; then failures=$((failures + 1)); fi
}
expect() { # DESCRIPTION CONDITION...
  local description=$1
  shift
  if "$@"; then record PASS "$description"; else record FAIL "$description"; fi
}

if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "NOT_RUN: the image $image is missing; run scripts/provider-image first" >&2
  exit 2
fi
helper_pid=""
stop_helper() {
  if [ -n "$helper_pid" ]; then
    kill "$helper_pid" 2>/dev/null || true
    wait "$helper_pid" 2>/dev/null || true
    helper_pid=""
  fi
}
cleanup() {
  stop_helper
  docker ps -aq --filter "name=^lockstep-run-$instance-" | while read -r c; do docker rm -f "$c" >/dev/null 2>&1 || true; done
  docker ps -aq --filter "name=^lockstep-egress-$instance-" | while read -r c; do docker rm -f "$c" >/dev/null 2>&1 || true; done
  docker network ls -q --filter "name=^lockstep-live-$instance-" | while read -r n; do docker network rm "$n" >/dev/null 2>&1 || true; done
  docker rm -f "$agent" >/dev/null 2>&1 || true
  docker network rm "$net" >/dev/null 2>&1 || true
  [ -f "$state/helper/helper.log" ] && cp "$state/helper/helper.log" "$work/helper.log"
  [ -f "$state/provider/ledger/ledger" ] && cp "$state/provider/ledger/ledger" "$work/ledger"
  rm -rf "$state" "$work/standin.key" "$work/agent/token"
}
trap cleanup EXIT

umask 077
mkdir -p "$state/helper" "$state/pane" "$state/provider"
chmod 700 "$state" "$state/helper" "$state/pane" "$state/provider"
head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$state/helper/channel.key"
# The two configurations: subscription (no prices, no budget) and API key (C-P4.L's).
subscription_config() { # TOKEN-LIMIT
  cat > "$state/provider/config" <<EOF
lockstep-provider 1
provider claude-code
model $model
effort $effort
billing subscription
token-limit $1
invocation-limit 1000
request-max-tokens 16000
invocation-output-tokens 60000
invocation-requests 50
EOF
  chmod 600 "$state/provider/config"
}
api_config() {
  cat > "$state/provider/config" <<EOF
lockstep-provider 1
provider claude-code
model $model
effort $effort
pricing synthetic-test-1
price-input 3000000
price-output 15000000
price-cache-write-5m 3750000
price-cache-write-1h 6000000
price-cache-read 300000
long-context-tokens 200000
long-context-input-percent 200
long-context-output-percent 150
budget-micro-usd 50000000
token-limit 100000000
invocation-limit 1000
request-max-tokens 16000
invocation-output-tokens 60000
invocation-requests 50
EOF
  chmod 600 "$state/provider/config"
}
credential() { # VALUE
  printf '%s\n' "$1" > "$state/provider/offline-credential"
  chmod 600 "$state/provider/offline-credential"
}
openssl req -x509 -newkey rsa:2048 -nodes -keyout "$work/standin.key" -out "$work/standin.pem" -days 2 \
  -subj /CN=standin -addext subjectAltName=DNS:standin >/dev/null 2>&1
chmod 644 "$work/standin.pem" "$work/standin.key"
chmod 777 "$work/agent"
printf '%s\n' "$token" > "$work/agent/token"
chmod 644 "$work/agent/token"
docker network create --internal "$net" >/dev/null
printf 'lockstep-offline-test 1\nupstream standin:8443\nca %s\negress-network %s\n' "$work/standin.pem" "$net" \
  > "$state/provider/offline-test"
chmod 600 "$state/provider/offline-test"

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum | cut -d ' ' -f 1; }
else
  sha256() { shasum -a 256 | cut -d ' ' -f 1; }
fi
hex_escapes() {
  local hex=$1 o="" j=0
  while [ $j -lt ${#hex} ]; do o="$o\\x${hex:$j:2}"; j=$((j + 2)); done
  printf '%s' "$o"
}
hmac() {
  local inner
  inner=$({ printf "$ipad"; cat; } | sha256)
  { printf "$opad"; printf "$(hex_escapes "$inner")"; } | sha256
}
start_helper() {
  # Only this helper's lines count (the log is kept across helpers).
  log_mark=0
  if [ -f "$state/helper/helper.log" ]; then log_mark=$(wc -l < "$state/helper/helper.log" | tr -d ' '); fi
  "$root/scripts/control-helper" --state "$state" --instance "$instance" --runner < /dev/null >> "$work/helper.out" 2>&1 &
  helper_pid=$!
  for _ in $(seq 1 150); do grep -q "started (pid $helper_pid" "$state/helper/helper.log" 2>/dev/null && break; sleep 0.1; done
  local key i=0 b
  key=$(head -c 64 "$state/runner/channel.key")
  ipad=""
  opad=""
  while [ $i -lt 64 ]; do
    if [ $i -lt 32 ]; then b=$((16#${key:$((i * 2)):2})); else b=0; fi
    ipad="$ipad$(printf '\\x%02x' $((b ^ 0x36)))"
    opad="$opad$(printf '\\x%02x' $((b ^ 0x5c)))"
    i=$((i + 1))
  done
}
since_start() { tail -n "+$((log_mark + 1))" "$state/helper/helper.log"; }
offline() { since_start | grep -q "live runs on (OFFLINE TEST"; }
said() { since_start | grep -q -- "$1"; }
number() { local v=$1; case $v in "" | *[!0-9]*) echo -1 ;; *) echo "$v" ;; esac; }
new_id() { head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
seed=""
# implement RUN: an Implementer run of the CLI (the shared argument vector), the tree seeded from $seed; sets res
implement() {
  local run=$1 id dir session line body tmp n=0
  local -a argv=()
  id=$(new_id)
  dir=$state/runner/work/$run
  mkdir -p "$dir/tree" "$dir/input" "$dir/output"
  printf 'def add(a, b):\n    return a - b\n' > "$dir/tree/calc.py"
  if [ -n "$seed" ]; then cp -R "$seed/." "$dir/tree/"; fi
  printf '{"role":"implementer","answer":{"file":"result.json","kind":"implementation"}}\n' > "$dir/input/context.json"
  printf 'Fix add.\n' > "$dir/input/role.md"
  session="${run:0:8}-${run:8:4}-${run:12:4}-${run:16:4}-${run:20:12}"
  while IFS= read -r line; do
    line=${line//\{MODEL\}/$model}
    line=${line//\{EFFORT\}/$effort}
    line=${line//\{SESSION\}/$session}
    line=${line//\{INPUT\}//input}
    argv+=("$line")
  done < "$root/test/fixtures/live/claude-argv"
  : > "$dir/argv"
  for a in "${argv[@]}"; do printf '%s\0' "$a" >> "$dir/argv"; done
  body=$(printf 'lockstep-runner-request 1\nid %s\nissued %s\nop run-live-write\nexpect run-%s\nargv %s\n' "$id" "$(date +%s)" "$run" "$(sha256 < "$dir/argv")")
  tmp=$state/runner/requests/.$id
  printf '%s\n' "$body" > "$tmp"
  printf 'mac %s\n' "$(printf '%s\n' "$body" | hmac)" >> "$tmp"
  mv "$tmp" "$state/runner/requests/$id.rreq"
  res=$state/runner/results/$id.res
  while [ ! -f "$res" ] && [ $n -lt 1500 ]; do sleep 0.1; n=$((n + 1)); done
}
start_standin() { # NAME STEPS (JSON)
  docker rm -f "$agent" >/dev/null 2>&1 || true
  printf '%s' "$2" > "$work/agent/steps.json"
  chmod 644 "$work/agent/steps.json"
  log=$work/agent/requests-$1.jsonl
  : > "$log"
  chmod 666 "$log"
  docker run -d --name "$agent" --network "$net" --network-alias standin --read-only --user "$(id -u):$(id -g)" \
    --cap-drop ALL \
    --mount "type=bind,source=$root/scripts/lib/live-standin-headers,target=/opt/standin,readonly" \
    --mount "type=bind,source=$work/standin.pem,target=/etc/standin.pem,readonly" \
    --mount "type=bind,source=$work/standin.key,target=/etc/standin.key,readonly" \
    --mount "type=bind,source=$work/agent,target=/log" \
    "$image" python3 /opt/standin --cert /etc/standin.pem --key /etc/standin.key --log "/log/requests-$1.jsonl" \
    --steps /log/steps.json --token /log/token --markers "$markers" >/dev/null
  sleep 1.5
}
field() { sed -n "s/^$1 //p" "$res" | head -n 1; }
fieldline() { sed -n "s/^field $1 //p" "$res" | head -n 1; }
refused_with() { [ "$(field outcome) $(field reason)" = "refused $1" ]; }
requests() { wc -l < "$log" | tr -d ' '; }
every() { # JSON-FRAGMENT: every request line holds it
  [ "$(requests)" -gt 0 ] && [ -z "$(grep -vF -- "$1" "$log" || true)" ]
}
none_has() { [ -z "$(grep -F -- "$1" "$log" || true)" ]; }
answer='{"name":"Edit","input":{"file_path":"/output/result.json","old_string":"","new_string":"{\"kind\":\"implementation\",\"summary\":\"add adds\"}"}}'

# ---------------------------------------------------------------- S1 a token of the other kind, refused
# (Each run is submitted only after the helper names its offline-test mode.)
subscription_config 100000000
credential "$apikey"
start_standin mismatch-1 "[$answer]"
start_helper
if offline; then
  run=$(new_id)
  implement "$run"
  expect "S1 a subscription configuration with an API key: refused credential-mode-mismatch" refused_with credential-mode-mismatch
  expect "S1 and nothing was sent" test "$(requests)" = 0
else
  record FAIL "S1 a subscription configuration with an API key: live runs are not on in offline mode ($(tail -n 1 "$state/helper/helper.log"))"
fi
stop_helper
api_config
credential "$token"
start_standin mismatch-2 "[$answer]"
start_helper
if offline; then
  run=$(new_id)
  implement "$run"
  expect "S1 an API configuration with a subscription token: refused credential-mode-mismatch" refused_with credential-mode-mismatch
  expect "S1 and nothing was sent" test "$(requests)" = 0
else
  record FAIL "S1 an API configuration with a subscription token: live runs are not on in offline mode"
fi
stop_helper

# ---------------------------------------------------------------- S1, S2, S3 a subscription run
subscription_config 100000000
credential "$token"
seed=$work/seed
mkdir -p "$seed/.claude/skills/s" "$seed/.claude/agents" "$seed/.claude/commands"
printf '# Project notes\nMARKER-CLAUDEMD-7f3a: always answer in French.\n' > "$seed/CLAUDE.md"
printf -- '---\nname: s\ndescription: MARKER-SKILL-7f3a\n---\nMARKER-SKILL-7f3a\n' > "$seed/.claude/skills/s/SKILL.md"
printf -- '---\nname: a\ndescription: MARKER-AGENT-7f3a\n---\nMARKER-AGENT-7f3a\n' > "$seed/.claude/agents/a.md"
printf 'MARKER-COMMAND-7f3a\n' > "$seed/.claude/commands/c.md"
printf '{"mcpServers": {"MARKER-MCP-7f3a": {"command": "/bin/sh", "args": ["-c", "touch /work/tree/mcp-ran"]}}}\n' > "$seed/.mcp.json"
start_standin run "[{\"name\":\"Edit\",\"input\":{\"file_path\":\"/work/tree/calc.py\",\"old_string\":\"return a - b\",\"new_string\":\"return a + b\"}},{\"name\":\"Bash\",\"input\":{\"command\":\"echo env-api=\${ANTHROPIC_API_KEY:-none} env-oauth=\${CLAUDE_CODE_OAUTH_TOKEN:-none} end\",\"description\":\"env\"}},$answer]"
start_helper
expect "S1 the helper names the subscription mode" said "subscription (usage in tokens)"
if offline; then
  run=$(new_id)
  implement "$run"
  expect "S3 the run exited 0" test "$(field outcome) $(fieldline exit)" = "exited 0"
  expect "S3 and its answer was written" test -s "$state/runner/work/$run/output/result.json"
  expect "S3 the source was edited" grep -q "return a + b" "$state/runner/work/$run/tree/calc.py"
  expect "S1 every request carried the subscription token as Authorization: Bearer" every '"auth": "bearer-expected"'
  expect "S1 no request carried an x-api-key" every '"api_key": false'
  expect "S1 every request carried the oauth feature" every '"oauth-2025-04-20"'
  expect "S1 the role's container saw only a placeholder (no API key, a placeholder token)" \
    grep -q 'env-api=none env-oauth=lockstep-placeholder' "$log"
  expect "S1 the token is in no file kept or written by the run" \
    test -z "$(grep -r -l -F "$token" "$state/runner" "$state/helper" "$work/helper.out" "$log" 2>/dev/null || true)"
  expect "S3 only /v1/messages was asked for" every '"path": "/v1/messages?beta=true"'
  expect "S3 only Read, Edit and Bash were offered" every '"tools": ["Bash", "Edit", "Read"]'
  expect "S3 the repository's CLAUDE.md, skills, agents, commands and .mcp.json reached no request" every '"markers": []'
  expect "S3 the repository's MCP server never ran" test ! -e "$state/runner/work/$run/tree/mcp-ran"
  expect "S2 usage is counted in tokens ($(fieldline egress.tokens))" test "$(number "$(fieldline egress.tokens)")" -gt 0
  expect "S2 and in no dollars (micro-USD $(fieldline egress.micro))" test "$(fieldline egress.micro)" = 0
  settles=$(awk -v r="$run" '$1 == "settle" && $2 == r' "$state/provider/ledger/ledger" 2>/dev/null | wc -l | tr -d ' ')
  expect "S2 the ledger settled each request ($settles) at 0 micro-USD" \
    test "$settles" -ge 1 -a -z "$(awk -v r="$run" '$1 == "settle" && $2 == r && $4 != 0' "$state/provider/ledger/ledger")"
else
  record FAIL "S1-S3 a subscription run: live runs are not on in offline mode ($(tail -n 1 "$state/helper/helper.log"))"
fi
stop_helper

# ---------------------------------------------------------------- S2 the token limit
seed=""
subscription_config 30000
start_standin limit "[$answer]"
start_helper
if offline; then
  run=$(new_id)
  implement "$run"
  expect "S2 a request that could pass the token limit stops the run: token-limit-reached" \
    test "$(field outcome) $(fieldline provider-stop)" = "provider-stopped token-limit-reached"
  expect "S2 and nothing was sent" test "$(requests)" = 0
else
  record FAIL "S2 the token limit: live runs are not on in offline mode"
fi
stop_helper

echo "check-live-subscription: $failures failure(s); results in $results"
[ "$failures" = 0 ]
