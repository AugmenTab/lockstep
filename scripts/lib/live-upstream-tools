#!/usr/bin/env python3
# A stand-in upstream for scripts/lib/check-live-concurrency (contract C-P4.L.R2
# §11; test only; never a model). HTTPS with the check's certificate. Every answer
# is a complete event stream asking for one tool call with a new id
# (toolu_c<N>), after DELAY seconds; with --fail-first the first request gets
# 529 (overloaded) instead. Appends one line per request to LOG.
#
#   live-upstream-tools --cert FILE --key FILE --log FILE [--delay S] [--fail-first]
import argparse
import http.server
import json
import ssl
import sys
import threading
import time


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--cert", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--log", required=True)
    p.add_argument("--delay", type=float, default=0.0)
    p.add_argument("--fail-first", action="store_true")
    a = p.parse_args()
    lock = threading.Lock()
    state = {"n": 0}

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_):
            pass

        def do_POST(self):
            self.rfile.read(int(self.headers.get("content-length", "0")))
            with lock:
                state["n"] += 1
                n = state["n"]
                with open(a.log, "a", encoding="utf-8") as f:
                    f.write("request %d\n" % n)
            if a.fail_first and n == 1:
                payload = b'{"type":"error","error":{"type":"overloaded_error","message":"overloaded"}}'
                self.send_response(529)
                self.send_header("content-type", "application/json")
                self.send_header("content-length", str(len(payload)))
                self.end_headers()
                self.wfile.write(payload)
                return
            time.sleep(a.delay)
            tool = "toolu_c%d" % n
            events = [
                {"type": "message_start", "message": {
                    "id": "msg_c%d" % n, "type": "message", "role": "assistant", "model": "x", "content": [],
                    "stop_reason": None, "stop_sequence": None,
                    "usage": {"input_tokens": 10, "output_tokens": 1, "cache_creation_input_tokens": 0,
                              "cache_read_input_tokens": 0}}},
                {"type": "content_block_start", "index": 0, "content_block": {
                    "type": "tool_use", "id": tool, "name": "Bash", "input": {}}},
                {"type": "content_block_delta", "index": 0, "delta": {
                    "type": "input_json_delta", "partial_json": "{\"command\": \"true\"}"}},
                {"type": "content_block_stop", "index": 0},
                {"type": "message_delta", "delta": {"stop_reason": "tool_use", "stop_sequence": None},
                 "usage": {"output_tokens": 5}},
                {"type": "message_stop"},
            ]
            payload = b"".join(b"event: " + e["type"].encode() + b"\ndata: " + json.dumps(e).encode() + b"\n\n"
                               for e in events)
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
            self.send_header("content-length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8443), Handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(a.cert, a.key)
    server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
