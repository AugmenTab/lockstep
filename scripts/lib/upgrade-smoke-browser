#!/usr/bin/env bash
# Browser stand-in for scripts/lib/check-upgrade (C-P3.3 §3). Called by the
# launcher with the control pane's sign-in address as its only argument; drives
# a real headless Chromium (test/browser/control_driver.py, host network) with
# real clicks through one flow, chosen by $LOCKSTEP_SMOKE_FLOW:
#
#   upgrade   prepare, review, install; expect "Done: Lockstep was upgraded."
#   fail      prepare, review, install; expect "The upgrade needs your attention"
#   recover   review recovery, restore; expect "Done: the previous version is back."
#
# The address goes to the driver on stdin and is never written anywhere.
set -euo pipefail
cd "$(dirname "$0")/../.."
out=${LOCKSTEP_SMOKE_OUT:?LOCKSTEP_SMOKE_OUT must name the summary file}
flow=${LOCKSTEP_SMOKE_FLOW:?LOCKSTEP_SMOKE_FLOW must be upgrade, fail or recover}
link=$1
case "$link" in
  http://127.0.0.1:[0-9]*/sign-in#*) ;;
  *) printf 'unexpected address\n' > "$out"; exit 1 ;;
esac
w() { printf ',{"op":"wait_text","label":"%s","text":"%s","timeout":"%s"}' "$1" "$2" "$3"; }
c() { printf ',{"op":"click","label":"%s","selector":"%s"}' "$1" "$2"; }
steps="[{\"op\":\"open\",\"label\":\"pane\",\"url\":\"$link\"}"
case $flow in
  upgrade | fail)
    steps="$steps$(w ready Installed 90)$(c prepare '#prepare-candidate')$(w candidate 'A new version is ready to install' 1800)$(c reviewbutton '#apply-review')$(w review 'Lockstep will' 30)$(c apply '#apply-candidate')"
    if [ "$flow" = upgrade ]; then
      steps="$steps$(w finished 'Done: Lockstep was upgraded.' 1800)"
    else
      steps="$steps$(w finished 'The upgrade needs your attention' 1800)"
    fi
    ;;
  recover)
    steps="$steps$(w ready 'The upgrade needs your attention' 90)$(c reviewbutton '#restore-review')$(w review 'Lockstep will' 30)$(c restore '#restore-previous')$(w finished 'Done: the previous version is back.' 1800)"
    ;;
  *) printf 'unknown flow\n' > "$out"; exit 1 ;;
esac
steps="$steps]"
link=""
driver=ok
raw=$(printf '%s' "$steps" | docker run -i --rm --network host --log-driver none \
  --volume "$PWD/test/browser:/browser:ro" lockstep-dev:p1 python3 /browser/control_driver.py) || driver=failed
steps=""
value() { printf '%s\n' "$raw" | awk -F '\t' -v k="$1" '$1 == k { print $2; exit }'; }
{
  printf 'driver=%s\n' "$driver"
  for label in ready candidate review finished; do
    printf '%s.found=%s\n' "$label" "$(value "$label.found")"
  done
  printf 'finished.text=%s\n' "$(value finished.text)"
} > "$out"
[ "$driver" = ok ]
