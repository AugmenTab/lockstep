#!/usr/bin/env python3
# A stand-in upstream that plays a role's turns for the real Claude Code CLI
# (contract C-P4.L.R2; test only; never a model). HTTPS with the check's
# certificate. It tells the run's own conversation (its first user message holds
# MARKER) from any other (a second agent started inside the container) and logs
# every request it receives (one JSON line: main or not, message count, tools,
# the text of the last tool result).
#
#   live-standin-agent --cert FILE --key FILE --log FILE --mode implement|bash
#                      --command FILE --answer FILE --marker TEXT
#
# The run's own conversation, by how many tool results it holds so far:
#   implement: 0 → Edit calc.py ("a - b" to "a + b"); 1 → Edit /output/result.json
#              with ANSWER's text; then the end of the turn
#   bash:      0 → Bash with COMMAND's text; 1 → Edit /output/result.json; then end
# Any other conversation (a second agent): 0 → Edit calc.py to return 'NESTED';
# then the end of its turn.
import argparse
import hashlib
import http.server
import json
import ssl
import sys


def strip(value):
    """The value without cache_control marks (they move from turn to turn)."""
    if isinstance(value, dict):
        return {k: strip(v) for k, v in value.items() if k != "cache_control"}
    if isinstance(value, list):
        return [strip(v) for v in value]
    return value


def first_text(messages):
    if not messages:
        return ""
    content = messages[0].get("content") if isinstance(messages[0], dict) else ""
    if isinstance(content, str):
        return content
    return "".join(b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text")


def tool_results(messages):
    out = []
    for m in messages:
        content = m.get("content") if isinstance(m, dict) else None
        if isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    c = b.get("content")
                    if isinstance(c, list):
                        c = "".join(x.get("text", "") for x in c if isinstance(x, dict))
                    out.append(str(c))
    return out


def stream(model, block, stop):
    events = [{"type": "message_start", "message": {
        "id": "msg_agent", "type": "message", "role": "assistant", "model": model, "content": [],
        "stop_reason": None, "stop_sequence": None,
        "usage": {"input_tokens": 100, "output_tokens": 1, "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0}}}]
    if block["type"] == "text":
        events.append({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": block["text"]}})
    else:
        events.append({"type": "content_block_start", "index": 0, "content_block": {
            "type": "tool_use", "id": block["id"], "name": block["name"], "input": {}}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {
            "type": "input_json_delta", "partial_json": json.dumps(block["input"])}})
    events.append({"type": "content_block_stop", "index": 0})
    events.append({"type": "message_delta", "delta": {"stop_reason": stop, "stop_sequence": None},
                   "usage": {"output_tokens": 40}})
    events.append({"type": "message_stop"})
    return b"".join(b"event: " + e["type"].encode() + b"\ndata: " + json.dumps(e).encode() + b"\n\n" for e in events)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--cert", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--log", required=True)
    p.add_argument("--mode", required=True)
    p.add_argument("--command", required=True)
    p.add_argument("--answer", required=True)
    p.add_argument("--marker", required=True)
    a = p.parse_args()

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_):
            pass

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("content-length", "0")))
            try:
                request = json.loads(body)
            except ValueError:
                request = {}
            messages = request.get("messages", [])
            main = a.marker in first_text(messages)
            results = tool_results(messages)
            with open(a.log, "a", encoding="utf-8") as f:
                f.write(json.dumps({
                    "main": main, "messages": len(messages),
                    "tools": sorted(t.get("name", "?") for t in request.get("tools", []) if isinstance(t, dict)),
                    "last_tool_result": results[-1][:2000] if results else None,
                    "roles": [m.get("role") for m in messages if isinstance(m, dict)],
                    "digests": [hashlib.sha256(json.dumps(strip(m), sort_keys=True).encode()).hexdigest()[:12]
                                for m in messages],
                    "kinds": [[b.get("type") for b in m.get("content")] if isinstance(m.get("content"), list) else "text"
                              for m in messages if isinstance(m, dict)],
                }) + "\n")
            n = len(results)
            if not main:
                block = ({"type": "tool_use", "id": "toolu_nested", "name": "Edit", "input": {
                    "file_path": "/work/tree/calc.py", "old_string": "return a - b",
                    "new_string": "return 'NESTED'"}} if n == 0 else {"type": "text", "text": "done"})
            elif n == 0 and a.mode == "implement":
                block = {"type": "tool_use", "id": "toolu_edit", "name": "Edit", "input": {
                    "file_path": "/work/tree/calc.py", "old_string": "return a - b", "new_string": "return a + b"}}
            elif n == 0:
                with open(a.command, encoding="utf-8") as f:
                    command = f.read()
                block = {"type": "tool_use", "id": "toolu_bash", "name": "Bash",
                         "input": {"command": command, "description": "run a command"}}
            elif n == 1:
                with open(a.answer, encoding="utf-8") as f:
                    answer = f.read()
                block = {"type": "tool_use", "id": "toolu_answer", "name": "Edit", "input": {
                    "file_path": "/output/result.json", "old_string": "", "new_string": answer}}
            else:
                block = {"type": "text", "text": "The answer is in /output/result.json."}
            payload = stream(request.get("model", "?"), block, "end_turn" if block["type"] == "text" else "tool_use")
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
            self.send_header("content-length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8443), Handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(a.cert, a.key)
    server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
