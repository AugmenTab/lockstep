#!/usr/bin/env python3
# A stand-in upstream for the real Claude Code CLI that also records how each
# request authenticates (contract C-P4.L.S; test only; never a model). HTTPS
# with the check's certificate. Plays scripted turns with fresh random tool-call
# ids, as scripts/lib/live-standin-secret does, and logs one JSON line a request:
#
#   method, path; auth: "bearer-expected" (Authorization: Bearer <the expected
#   token>), "bearer-other", or "none"; api_key: whether an x-api-key header came;
#   betas: the anthropic-beta features; markers: which of the given marker
#   strings appear anywhere in the body; tools: the tool names offered;
#   results: the tool results so far; issued: the ids issued in the answer.
#
#   live-standin-headers --cert FILE --key FILE --log FILE --steps FILE
#                        --token FILE --markers A,B,...
#
# The expected token is only compared, never written.
import argparse
import hmac
import http.server
import json
import secrets
import ssl
import string
import sys

ALPHABET = string.ascii_letters + string.digits


def new_id():
    return "toolu_01" + "".join(secrets.choice(ALPHABET) for _ in range(22))


def tool_results(messages):
    out = []
    for m in messages:
        content = m.get("content") if isinstance(m, dict) else None
        if isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    c = b.get("content")
                    if isinstance(c, list):
                        c = "".join(x.get("text", "") for x in c if isinstance(x, dict))
                    out.append(str(c))
    return out


def stream(model, block, stop):
    events = [{"type": "message_start", "message": {
        "id": "msg_headers", "type": "message", "role": "assistant", "model": model, "content": [],
        "stop_reason": None, "stop_sequence": None,
        "usage": {"input_tokens": 100, "output_tokens": 1, "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0}}}]
    if block["type"] == "text":
        events.append({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": block["text"]}})
    else:
        events.append({"type": "content_block_start", "index": 0, "content_block": {
            "type": "tool_use", "id": block["id"], "name": block["name"], "input": {}}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {
            "type": "input_json_delta", "partial_json": json.dumps(block["input"])}})
    events.append({"type": "content_block_stop", "index": 0})
    events.append({"type": "message_delta", "delta": {"stop_reason": stop, "stop_sequence": None},
                   "usage": {"output_tokens": 40}})
    events.append({"type": "message_stop"})
    return b"".join(b"event: " + e["type"].encode() + b"\ndata: " + json.dumps(e).encode() + b"\n\n" for e in events)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--cert", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--log", required=True)
    p.add_argument("--steps", required=True)
    p.add_argument("--token", required=True)
    p.add_argument("--markers", required=True)
    a = p.parse_args()
    with open(a.token, encoding="ascii") as f:
        expected = "Bearer " + f.read().strip()
    markers = [m for m in a.markers.split(",") if m]

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_):
            pass

        def entry(self, body):
            auth = self.headers.get("authorization")
            if auth is None:
                kind = "none"
            elif hmac.compare_digest(auth.encode(), expected.encode()):
                kind = "bearer-expected"
            else:
                kind = "bearer-other"
            betas = []
            for value in self.headers.get_all("anthropic-beta") or []:
                betas += [b.strip() for b in value.split(",") if b.strip()]
            text = body.decode("utf-8", "replace")
            return {"method": self.command, "path": self.path, "auth": kind,
                    "api_key": self.headers.get("x-api-key") is not None, "betas": betas,
                    "markers": [m for m in markers if m in text]}

        def write(self, record):
            with open(a.log, "a", encoding="utf-8") as f:
                f.write(json.dumps(record) + "\n")

        def do_GET(self):
            self.write(self.entry(b""))
            self.send_response(404)
            self.send_header("content-length", "0")
            self.end_headers()

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("content-length", "0")))
            record = self.entry(body)
            try:
                request = json.loads(body)
            except ValueError:
                request = {}
            messages = request.get("messages", [])
            results = tool_results(messages)
            with open(a.steps, encoding="utf-8") as f:
                steps = json.load(f)
            n = len(results)
            if n < len(steps):
                block = dict(steps[n], type="tool_use", id=new_id())
            else:
                block = {"type": "text", "text": "The answer is in /output/result.json."}
            record.update({
                "tools": sorted(t.get("name", "?") for t in request.get("tools", []) if isinstance(t, dict)),
                "results": [r[:4000] for r in results],
                "issued": [block["id"]] if block["type"] == "tool_use" else [],
            })
            self.write(record)
            payload = stream(request.get("model", "?"), block, "end_turn" if block["type"] == "text" else "tool_use")
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
            self.send_header("content-length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8443), Handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(a.cert, a.key)
    server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
