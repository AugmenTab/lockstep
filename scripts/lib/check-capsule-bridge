#!/usr/bin/env bash
# P5.1 tool-routing feasibility check, and the P5.5 bridge regression (contract C-P5.1 T1-T9).
#
# The real pinned Claude Code CLI (lockstep-provider:claude-2.1.312) runs with no built-in tools
# (--tools "") and one MCP server, the capsule bridge (--strict-mcp-config). A stand-in upstream
# (scripts/lib/live-standin-secret: scripted tool calls, synthetic key, an internal network: no
# provider contacted, no credential needed) drives it. Every tool call must be executed by the
# Capsule Runtime (scripts/capsule-runtime serve) inside the capsule; here the capsule is the
# runtime's FIXTURE backend (a network-less container standing in for the guest VM), because this
# check is about where model-directed operations run, not about the VM (check-capsule-vm is).
#
# Results: .local/evidence/capsule-bridge-<stamp>/results.txt
set -uo pipefail
cd "$(dirname "$0")/../.."
root=$PWD

stamp=$(date -u +%Y%m%dt%H%M%Sz)
work=$root/.local/evidence/capsule-bridge-$stamp
state=$root/.local/capsule-bridge-$stamp
mkdir -p "$work/agent"
results=$work/results.txt
: > "$results"
failures=0
image=lockstep-provider:claude-2.1.312
net=lockstep-cb-$stamp
standin=lockstep-cb-standin-$stamp
cli=lockstep-cb-cli-$stamp
cap=spike-capsule
proj=spike-project
runtime=$root/scripts/capsule-runtime
serve_pid=""

record() { printf '%s %s\n' "$1" "$2" | tee -a "$results"; [ "$1" = PASS ] || failures=$((failures + 1)); }
expect() { local d=$1; shift; if "$@"; then record PASS "$d"; else record FAIL "$d"; fi; }

docker image inspect "$image" >/dev/null 2>&1 || { echo "NOT_RUN: $image is missing" >&2; exit 2; }
cleanup() {
  [ -n "$serve_pid" ] && kill "$serve_pid" 2>/dev/null
  docker rm -f "$standin" "$cli" "lockstep-$cap" >/dev/null 2>&1
  docker network rm "$net" >/dev/null 2>&1
  [ -f "$state/capsules/journal" ] && cp "$state/capsules/journal" "$work/runtime-journal.txt"
  rm -rf "$state" "$work/standin.key"
}
trap cleanup EXIT

mkdir -p "$state/capsules"
chmod 700 "$state" "$state/capsules"
: > "$state/capsules/fixture-backend"
new_id() { head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

# The capsule (fixture backend), with a marker only the capsule has.
"$runtime" --state "$state" provision "$cap" "$proj" "small,disposable" > "$work/provision.txt" 2>&1
expect "T0 the runtime provisioned the fixture capsule" grep -q '^capsule-runtime 1 provision ok .*backend=fixture' "$work/provision.txt"
marker=capsule-marker-$(new_id)
docker exec "lockstep-$cap" sh -c "echo $marker > /etc/lockstep-marker; printf 'alpha\nbeta\n' > /tmp/work/notes.txt"

openssl req -x509 -newkey rsa:2048 -nodes -keyout "$work/standin.key" -out "$work/standin.pem" -days 2 \
  -subj /CN=standin -addext subjectAltName=DNS:standin >/dev/null 2>&1
chmod 644 "$work/standin.pem" "$work/standin.key"
chmod 777 "$work/agent"
docker network create --internal "$net" >/dev/null

start_standin() { # NAME STEPS-JSON
  docker rm -f "$standin" >/dev/null 2>&1
  printf '%s' "$2" > "$work/agent/steps.json"
  chmod 644 "$work/agent/steps.json"
  log=$work/agent/standin-$1.jsonl
  : > "$log"
  chmod 666 "$log"
  docker run -d --name "$standin" --network "$net" --network-alias standin --read-only --user "$(id -u):$(id -g)" \
    --cap-drop ALL \
    --mount "type=bind,source=$root/scripts/lib/live-standin-secret,target=/opt/standin,readonly" \
    --mount "type=bind,source=$work/standin.pem,target=/etc/standin.pem,readonly" \
    --mount "type=bind,source=$work/standin.key,target=/etc/standin.key,readonly" \
    --mount "type=bind,source=$work/agent,target=/log" \
    "$image" python3 /opt/standin --cert /etc/standin.pem --key /etc/standin.key --log "/log/standin-$1.jsonl" \
    --steps /log/steps.json >/dev/null
  sleep 1.5
}

run_cli() { # CHANNEL ROLE WAIT-LIMIT OUT
  local mcp
  mcp="{\"mcpServers\":{\"capsule\":{\"type\":\"stdio\",\"command\":\"/usr/bin/python3\",\"args\":[\"/opt/lockstep/capsule-bridge\",\"--channel\",\"/bridge\",\"--role\",\"$2\",\"--wait-limit\",\"$3\"]}}}"
  docker rm -f "$cli" >/dev/null 2>&1
  ( sleep 300; docker kill "$cli" >/dev/null 2>&1 ) &
  local guard=$!
  docker run --rm --name "$cli" --network "$net" --read-only \
    --tmpfs /tmp:rw,nosuid,nodev,size=268435456 \
    --cap-drop ALL --cap-add SETUID --cap-add SETGID --cap-add DAC_OVERRIDE --cap-add KILL \
    --security-opt no-new-privileges --user 0:0 --workdir /tmp \
    --env HOME=/tmp --env LANG=C.UTF-8 --env TZ=UTC \
    --env ANTHROPIC_BASE_URL=https://standin:8443 \
    --env "ANTHROPIC_API_KEY=sk-ant-test-$(new_id)" \
    --env NODE_EXTRA_CA_CERTS=/etc/lockstep/ca.pem \
    --env CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 --env DISABLE_AUTOUPDATER=1 \
    --env DISABLE_TELEMETRY=1 --env DISABLE_ERROR_REPORTING=1 --env MCP_TOOL_TIMEOUT=7200000 \
    --mount "type=bind,source=$work/standin.pem,target=/etc/lockstep/ca.pem,readonly" \
    --mount "type=bind,source=$root/scripts/runner/provider/capsule-bridge,target=/opt/lockstep/capsule-bridge,readonly" \
    --mount "type=bind,source=$1,target=/bridge" \
    "$image" /opt/lockstep/agent-entry "$(id -u)" "$(id -g)" \
    claude -p --model claude-sonnet-5-5 --tools "" --dangerously-skip-permissions --no-session-persistence \
    --output-format json --strict-mcp-config --mcp-config "$mcp" --disable-slash-commands \
    "Fix the bug in the capsule." > "$4" 2> "$4.err"
  kill "$guard" 2>/dev/null
}
said() { grep -qF -- "$1" "$log"; }
not_said() { ! grep -qF -- "$1" "$log"; }
in_capsule() { docker exec "lockstep-$cap" test -e "$1"; }
not_in_capsule() { ! docker exec "lockstep-$cap" test -e "$1"; }

# ---- run 1: an implementer invocation, the executor serving its channel.
inv=$(new_id)
tx=$(new_id)
"$runtime" --state "$state" bind "$inv" "$cap" "$proj" "$tx" implementer 120 > "$work/bind1.txt"
chan=$state/capsules/invocations/$inv/channel
"$runtime" --state "$state" serve "$inv" > "$work/serve1.txt" 2>&1 &
serve_pid=$!
steps='[
 {"name":"mcp__capsule__exec","input":{"command":"echo hello-from-capsule; cat /etc/lockstep-marker; echo to-stderr >&2; exit 3"}},
 {"name":"mcp__capsule__write","input":{"path":"src/made.txt","content":"one\ntwo\nthree\n"}},
 {"name":"mcp__capsule__edit","input":{"path":"src/made.txt","old_string":"two","new_string":"TWO-EDITED"}},
 {"name":"mcp__capsule__read","input":{"path":"src/made.txt"}},
 {"name":"mcp__capsule__search","input":{"pattern":"TWO-ED","path":"."}},
 {"name":"mcp__capsule__list","input":{"path":"src"}},
 {"name":"mcp__capsule__exec","input":{"command":"for i in 1 2 3; do echo line$i; done | while read l; do printf \"%s;\" \"$l\"; done; echo; (cd src && ls) > sub.txt && cat sub.txt","timeout_seconds":60}},
 {"name":"mcp__capsule__exec","input":{"command":"sleep 30; echo late > /tmp/work/late.txt","timeout_seconds":2}},
 {"name":"Bash","input":{"command":"echo FALLBACK > /bridge/fallback.txt","description":"x"}},
 {"name":"mcp__capsule__exec","input":{"command":"ls -la /auth /bridge 2>&1; echo anthropic-count=$(env | grep -ci anthropic)"}}
]'
start_standin r1 "$steps"
run_cli "$chan" write 120 "$work/cli1.json"
cp "$log" "$work/standin-r1.jsonl"
expect "T1 exec ran in the capsule (its output came back)" said "hello-from-capsule"
expect "T1 exec saw the capsule's own marker (the fixture, not the provider's container)" said "$marker"
expect "T1 exec returned its exit status (3) and stderr" said "exit: 3"
expect "T1 stderr is returned separately" said "to-stderr"
expect "T2 write created the file in the capsule" in_capsule /tmp/work/src/made.txt
expect "T2 edit changed it (read back)" said "TWO-EDITED"
expect "T3 read returned numbered lines" said "     3"
expect "T3 search found the edit" said "made.txt:2:TWO-EDITED"
expect "T3 list listed the directory" said "file made.txt"
expect "T4 multiline/pipes/subshells/redirects ran unrestricted" said "line1;line2;line3;"
expect "T5 a command over its time limit was reported timed out" said "outcome: timed-out"
sleep 31
expect "T5 the timed-out command was ended (it wrote nothing afterwards)" not_in_capsule /tmp/work/late.txt
expect "T6 the built-in Bash tool does not exist for the CLI" said "No such tool available"
expect "T6 nothing ran in the provider's container (no fallback file)" test ! -e "$chan/fallback.txt"
expect "T7 model-directed commands cannot see the provider's auth or channel paths" said "cannot access '/auth'"
expect "T7 nor the provider's environment (no ANTHROPIC variable in the capsule)" said "anthropic-count=0"
expect "T8 the CLI finished the run (exit 0, JSON result)" grep -q '"type":"result"' "$work/cli1.json"
kill "$serve_pid" 2>/dev/null
wait "$serve_pid" 2>/dev/null
serve_pid=""
"$runtime" --state "$state" close "$inv" >/dev/null

# ---- run 2: the executor is not serving (bridge unavailable): nothing may run anywhere.
inv=$(new_id)
"$runtime" --state "$state" bind "$inv" "$cap" "$proj" "$tx" implementer 120 > "$work/bind2.txt"
chan=$state/capsules/invocations/$inv/channel
start_standin r2 '[
 {"name":"mcp__capsule__exec","input":{"command":"echo ran > /tmp/work/should-not.txt"}},
 {"name":"Bash","input":{"command":"echo FALLBACK > /bridge/fallback2.txt","description":"x"}}
]'
run_cli "$chan" write 4 "$work/cli2.json"
cp "$log" "$work/standin-r2.jsonl"
expect "T9 with no executor the call fails closed (no answer, outcome unknown)" said "did not answer in time"
expect "T9 and nothing ran in the capsule" not_in_capsule /tmp/work/should-not.txt
expect "T9 and nothing ran in the provider's container" test ! -e "$chan/fallback2.txt"
"$runtime" --state "$state" close "$inv" >/dev/null

# ---- run 3: a read-only role: the bridge offers no write tool, and the host refuses a forged one.
inv=$(new_id)
"$runtime" --state "$state" bind "$inv" "$cap" "$proj" "$tx" reviewer 120 > "$work/bind3.txt"
chan=$state/capsules/invocations/$inv/channel
"$runtime" --state "$state" serve "$inv" > "$work/serve3.txt" 2>&1 &
serve_pid=$!
start_standin r3 '[
 {"name":"mcp__capsule__write","input":{"path":"src/reviewer.txt","content":"x"}},
 {"name":"mcp__capsule__read","input":{"path":"src/made.txt"}}
]'
run_cli "$chan" readonly 60 "$work/cli3.json"
cp "$log" "$work/standin-r3.jsonl"
expect "T10 a reviewer has no write tool" said "No such tool available"
expect "T10 nothing was written" not_in_capsule /tmp/work/src/reviewer.txt
expect "T10 a reviewer can read" said "TWO-EDITED"
printf '{"v": 1, "seq": 900, "op": "write", "args": {"path": "src/forged.txt", "content": "x"}}' > "$chan/requests/.900"
mv "$chan/requests/.900" "$chan/requests/900.json"
sleep 2
expect "T10 the host refuses a forged write in a reviewer's channel" grep -q '"host_outcome": "refused", "host_detail": "op-not-authorized-for-role"' "$chan/results/900.json"
expect "T10 and the forged write did not happen" not_in_capsule /tmp/work/src/forged.txt
printf '{"v": 1, "seq": 901, "op": "exec", "args": {"command": "touch /tmp/work/forged-exec"}}' > "$chan/requests/.901"
mv "$chan/requests/.901" "$chan/requests/901.json"
sleep 2
expect "T10 the host refuses a forged exec in a reviewer's channel" grep -q 'op-not-authorized-for-role' "$chan/results/901.json"
kill "$serve_pid" 2>/dev/null
wait "$serve_pid" 2>/dev/null
serve_pid=""

# ---- binding authority (no CLI needed).
"$runtime" --state "$state" bind "$(new_id)" "$cap" other-project "$tx" implementer 60 > "$work/bind-other.txt" 2>&1
expect "T11 a binding for another project is refused" grep -q 'refused reason=capsule-owned-by-another-project' "$work/bind-other.txt"
"$runtime" --state "$state" bind "$(new_id)" "../etc" "$proj" "$tx" implementer 60 > "$work/bind-bad.txt" 2>&1
expect "T11 an invalid capsule id is refused" grep -q 'refused reason=invalid-capsule-id' "$work/bind-bad.txt"
w1=$(new_id)
"$runtime" --state "$state" bind "$w1" "$cap" "$proj" "$tx" implementer 60 > /dev/null 2>&1
"$runtime" --state "$state" bind "$(new_id)" "$cap" "$proj" "$tx" implementer 60 > "$work/bind-second.txt" 2>&1
expect "T12 a second live writer for the project is refused" grep -q 'refused reason=writer-already-active' "$work/bind-second.txt"

echo "check-capsule-bridge: $failures failure(s); results in $results"
[ "$failures" = 0 ]
