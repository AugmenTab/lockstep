#!/usr/bin/env python3
# A stand-in upstream for the real Claude Code CLI whose tool-call ids are secret
# (contract C-P4.L.R3; test only; never a model). HTTPS with the check's
# certificate. Each answer's tool call gets a fresh random id, as the real
# upstream's are, so a process can continue the run's conversation only if it
# learns the id from somewhere. The run's turns follow a script:
#
#   live-standin-secret --cert FILE --key FILE --log FILE --steps FILE
#
# STEPS is a JSON list of tool calls ({"name": ..., "input": {...}}), one a turn,
# by how many tool results the conversation holds so far; after the last, the
# end of the turn. Every request is logged as one JSON line: the message count,
# the tool results it carries, and the ids issued in the answer.
import argparse
import json
import secrets
import ssl
import http.server
import string
import sys

ALPHABET = string.ascii_letters + string.digits


def new_id():
    return "toolu_01" + "".join(secrets.choice(ALPHABET) for _ in range(22))


def tool_results(messages):
    out = []
    for m in messages:
        content = m.get("content") if isinstance(m, dict) else None
        if isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_result":
                    c = b.get("content")
                    if isinstance(c, list):
                        c = "".join(x.get("text", "") for x in c if isinstance(x, dict))
                    out.append(str(c))
    return out


def stream(model, block, stop):
    events = [{"type": "message_start", "message": {
        "id": "msg_secret", "type": "message", "role": "assistant", "model": model, "content": [],
        "stop_reason": None, "stop_sequence": None,
        "usage": {"input_tokens": 100, "output_tokens": 1, "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": 0}}}]
    if block["type"] == "text":
        events.append({"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": block["text"]}})
    else:
        events.append({"type": "content_block_start", "index": 0, "content_block": {
            "type": "tool_use", "id": block["id"], "name": block["name"], "input": {}}})
        events.append({"type": "content_block_delta", "index": 0, "delta": {
            "type": "input_json_delta", "partial_json": json.dumps(block["input"])}})
    events.append({"type": "content_block_stop", "index": 0})
    events.append({"type": "message_delta", "delta": {"stop_reason": stop, "stop_sequence": None},
                   "usage": {"output_tokens": 40}})
    events.append({"type": "message_stop"})
    return b"".join(b"event: " + e["type"].encode() + b"\ndata: " + json.dumps(e).encode() + b"\n\n" for e in events)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--cert", required=True)
    p.add_argument("--key", required=True)
    p.add_argument("--log", required=True)
    p.add_argument("--steps", required=True)
    a = p.parse_args()

    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *_):
            pass

        def do_POST(self):
            body = self.rfile.read(int(self.headers.get("content-length", "0")))
            try:
                request = json.loads(body)
            except ValueError:
                request = {}
            messages = request.get("messages", [])
            results = tool_results(messages)
            with open(a.steps, encoding="utf-8") as f:
                steps = json.load(f)
            n = len(results)
            if n < len(steps):
                block = dict(steps[n], type="tool_use", id=new_id())
            else:
                block = {"type": "text", "text": "The answer is in /output/result.json."}
            with open(a.log, "a", encoding="utf-8") as f:
                f.write(json.dumps({
                    "messages": len(messages),
                    "results": [r[:4000] for r in results],
                    "issued": [block["id"]] if block["type"] == "tool_use" else [],
                }) + "\n")
            payload = stream(request.get("model", "?"), block, "end_turn" if block["type"] == "text" else "tool_use")
            self.send_response(200)
            self.send_header("content-type", "text/event-stream")
            self.send_header("content-length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)

    server = http.server.ThreadingHTTPServer(("0.0.0.0", 8443), Handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.load_cert_chain(a.cert, a.key)
    server.socket = context.wrap_socket(server.socket, server_side=True)
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())
