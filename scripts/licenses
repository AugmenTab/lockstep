#!/usr/bin/env bash
# License inventory (ARCHITECTURE §5.2, AC-P0-08): every transitive Haskell
# dependency of the shipped lockstep library and executable (test suites
# excluded) with its declared license, then the native libraries the built
# executable links. Runs in the dev container.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -z "${LOCKSTEP_IN_CONTAINER:-}" ]; then
  docker build --quiet --tag lockstep-dev:p1 . >/dev/null
  exec docker run --rm -e LOCKSTEP_IN_CONTAINER=1 \
    --volume "$PWD:/work" --volume lockstep-stack-root:/stack-root --workdir /work \
    lockstep-dev:p1 scripts/licenses "$@"
fi

echo "== Haskell dependencies of lockstep (lib + exe), name version license"
stack ls dependencies --separator ' ' lockstep | sort >/tmp/deps-versions
stack ls dependencies --license --separator ' ' lockstep | sort >/tmp/deps-licenses
join /tmp/deps-versions /tmp/deps-licenses

echo
echo "== native libraries linked by the lockstep executable (ldd)"
stack build --copy-bins --local-bin-path /tmp/lockstep-bin >/dev/null 2>&1
ldd /tmp/lockstep-bin/lockstep | awk '{ print $1, $3 }' | sort

echo
echo "== Debian packages providing those libraries"
ldd /tmp/lockstep-bin/lockstep | awk '$3 ~ /^\// { print $1 }' | while read -r lib; do
  dpkg -S "*/$lib" 2>/dev/null | cut -d: -f1 | head -n 1
done | sort -u | while read -r pkg; do
  printf '%s %s\n' "$pkg" "$(dpkg-query -W -f='${Version}' "$pkg")"
done
