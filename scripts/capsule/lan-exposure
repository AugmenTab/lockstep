#!/usr/bin/env bash
# Which host listeners a Dev Capsule could reach through the Mac's own addresses, and whether a scoped,
# expiring LAN exception accepts each one (Phase 5 update 2 §3). Used by scripts/capsule-preflight.
#
#   lan-exposure --project P --capsule C --verify-capsule V --lockstep-project U [--exception FILE]
#                --now EPOCH --tcp FILE --udp FILE
#
# --tcp and --udp are the complete outputs of "netstat -anv -p tcp" and "netstat -anv -p udp", each from a
# run that exited 0 (the caller checks that; update 3). Each must have the exact macOS structure: the
# title line, the column header ending in the process and the eight trailing columns, and only rows of its
# own protocol whose process column reads NAME:PID. Anything else is not an inventory: the verdict is
# "inventory refused: REASON" and nothing is accepted. A file with the two header lines and no rows is a
# genuinely empty inventory.
#
# A listener is a TCP socket in LISTEN or an unconnected UDP socket bound to a port, whose local address
# is not loopback. (A connected UDP socket only receives from its one peer; a "*.*" socket has no port.)
#
# The exception file (DIR/capsule/lan-exception, written by the owner, mode 0600):
#
#   lockstep-lan-exception 1
#   project P               the capsule config's project            } all four must match the
#   lockstep-project U      the Lockstep project it serves          } capsule config the preflight
#   capsule C               the Engineer's capsule                  } is checking: an exception never
#   verify-capsule V        the verification capsule                } carries over to another project
#   expires YYYY-MM-DDTHH:MM:SSZ   in the future, and at most 72 hours ahead
#   purpose TEXT            why (recorded, not interpreted)
#   allow tcp|udp BIND PORT PROCESS
#
# BIND is "*" (bound to every address) or "address" (bound to one non-loopback address). PORT is a
# number, or "dynamic" (49152-65535: ports the system hands out, which change). PROCESS is the name
# netstat shows (it truncates long names). Every listener must match an allow line exactly, protocol
# included; a listener nothing names is refused, so a service started later is refused too.
#
# Prints one line per listener ("approved"/"unapproved", with the allow line that matched), then the
# verdict: "exposure ok", "exposure refused: LIST", "exception refused: REASON" or
# "inventory refused: REASON". Exits 0 only on ok.
set -u
export LC_ALL=C

project="" capsule="" vcapsule="" lproject="" exception="" now="" tcpf="" udpf=""
while [ $# -gt 0 ]; do
  case $1 in
    --project) project=$2; shift 2 ;;
    --capsule) capsule=$2; shift 2 ;;
    --verify-capsule) vcapsule=$2; shift 2 ;;
    --lockstep-project) lproject=$2; shift 2 ;;
    --exception) exception=$2; shift 2 ;;
    --now) now=$2; shift 2 ;;
    --tcp) tcpf=$2; shift 2 ;;
    --udp) udpf=$2; shift 2 ;;
    *) echo "usage: lan-exposure --project P --capsule C --verify-capsule V --lockstep-project U [--exception FILE] --now EPOCH --tcp FILE --udp FILE" >&2; exit 64 ;;
  esac
done
[[ $now =~ ^[0-9]{9,11}$ ]] || { echo "lan-exposure: --now takes epoch seconds" >&2; exit 64; }
[ -n "$tcpf" ] && [ -n "$udpf" ] || { echo "lan-exposure: --tcp and --udp are required" >&2; exit 64; }

max_ahead=$((72 * 3600))

# The inventory's structure (update 3). Prints nothing if FILE is a well-formed netstat -anv listing for
# PROTO, otherwise the first problem. The parse below relies on exactly this: the process at NF-8, the TCP
# state at $6, the UDP foreign address at $5.
inventory_problem() {
  local proto=$1 file=$2
  [ -f "$file" ] && [ ! -L "$file" ] || { echo "$proto inventory missing"; return; }
  [ -s "$file" ] || { echo "$proto inventory empty (netstat printed nothing)"; return; }
  awk -v proto="$proto" '
    function bad(why) { print proto " inventory line " NR ": " why; exit }
    NR == 1 { if ($0 != "Active Internet connections (including servers)") bad("unrecognized title"); next }
    NR == 2 {
      if ($0 !~ /^Proto +Recv-Q +Send-Q +Local Address +Foreign Address +\(state\) /) bad("unrecognized column header")
      if ($(NF-8) != "process:pid" || $NF != "fltrs") bad("column header without the process and flag columns (not netstat -anv)")
      next
    }
    {
      if ($1 !~ ("^" proto "(4|6|46)?$")) bad("not a " proto " row")
      if (NF < (proto == "tcp" ? 19 : 18)) bad("too few columns")
      if ($4 !~ /\.([0-9]+|\*)$/) bad("unrecognized local address")
      if (proto == "tcp" && $6 !~ /^[A-Z_0-9]+$/) bad("unrecognized state")
      if ($(NF-8) !~ /:[0-9]+$/) bad("no process:pid column")
    }
    END { if (NR < 2) print proto " inventory truncated (no column header)" }' "$file" | head -n 1
}
inventory=""
for p in tcp udp; do
  f=$tcpf; [ "$p" = udp ] && f=$udpf
  inventory=$(inventory_problem "$p" "$f")
  [ -z "$inventory" ] || break
done

# The listeners: "PROTO BIND PORT PROCESS" (PROTO tcp|udp; BIND * or address; PROCESS may hold spaces).
listeners=""
[ -n "$inventory" ] || listeners=$(cat "$tcpf" "$udpf" | awk '
  $1 ~ /^(tcp|udp)(4|6|46)?$/ {
    proto = substr($1, 1, 3)
    if (proto == "tcp") { if ($6 != "LISTEN") next; first = 11 }
    else { if ($5 != "*.*") next; first = 10 }
    addr = $4
    n = split(addr, part, "."); port = part[n]
    if (port == "*" || port !~ /^[0-9]+$/) next
    host = substr(addr, 1, length(addr) - length(port) - 1)
    if (host ~ /^127\./ || host == "::1" || host ~ /^fe80::1%lo0/) next
    bind = (host == "*") ? "*" : "address"
    proc = $first
    for (i = first + 1; i <= NF - 8; i++) proc = proc " " $i
    sub(/:[0-9]+$/, "", proc)
    print proto " " bind " " port " " proc
  }' | sort -u)

reason=""
allows=""
if [ -n "$exception" ]; then
  if [ ! -f "$exception" ] || [ -L "$exception" ]; then
    reason="exception-missing"
  elif [ "$(head -n 1 "$exception")" != "lockstep-lan-exception 1" ]; then
    reason="exception-malformed"
  else
    field() { sed -n "s/^$1 //p" "$exception"; }
    one() { [ "$(grep -c "^$1 " "$exception")" = 1 ]; }
    expires=$(field expires)
    for key in project lockstep-project capsule verify-capsule expires purpose; do
      one "$key" || reason="exception-malformed ($key must appear exactly once)"
    done
    if [ -z "$reason" ]; then
      # Anything but the known lines is refused: the file is policy, not free text.
      # (An empty line is allowed: the group is optional. BSD grep refuses an empty alternative.)
      if grep -vqE '^(lockstep-lan-exception 1|project [^ ]+|lockstep-project [^ ]+|capsule [^ ]+|verify-capsule [^ ]+|expires [^ ]+|purpose .+|allow (tcp|udp) (\*|address) ([0-9]{1,5}|dynamic) [^ ].*|#.*)?$' "$exception"; then
        reason="exception-malformed (an unknown or malformed line)"
      elif [ "$(field project)" != "$project" ]; then reason="exception-wrong-project"
      elif [ -z "$lproject" ] || [ "$(field lockstep-project)" != "$lproject" ]; then reason="exception-wrong-lockstep-project"
      elif [ "$(field capsule)" != "$capsule" ]; then reason="exception-wrong-capsule"
      elif [ -z "$vcapsule" ] || [ "$(field verify-capsule)" != "$vcapsule" ]; then reason="exception-wrong-verify-capsule"
      else
        exp=""
        if [[ $expires =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
          exp=$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$expires" +%s 2>/dev/null || date -u -d "$expires" +%s 2>/dev/null)
        fi
        if ! [[ $exp =~ ^[0-9]+$ ]]; then reason="exception-malformed (expires)"
        elif [ "$exp" -le "$now" ]; then reason="exception-expired ($expires)"
        elif [ $((exp - now)) -gt "$max_ahead" ]; then reason="exception-expiry-too-far ($expires is more than 72 hours ahead)"
        else allows=$(sed -n 's/^allow //p' "$exception")
        fi
      fi
    fi
  fi
fi

unapproved=""
while IFS= read -r l; do
  [ -n "$l" ] || continue
  read -r proto bind port proc <<< "$l"
  match=""
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    read -r aproto abind aport aproc <<< "$a"
    [ "$aproto" = "$proto" ] && [ "$abind" = "$bind" ] && [ "$aproc" = "$proc" ] || continue
    if [ "$aport" = "$port" ] || { [ "$aport" = dynamic ] && [ "$port" -ge 49152 ] && [ "$port" -le 65535 ]; }; then
      match=$a
      break
    fi
  done <<< "$allows"
  if [ -n "$match" ]; then
    echo "approved $proto $bind $port $proc (allow $match)"
  else
    echo "unapproved $proto $bind $port $proc"
    unapproved="$unapproved $proto/$port($proc)"
  fi
done <<< "$listeners"

# An inventory that cannot be read is no evidence that nothing listens: refuse, accept nothing.
if [ -n "$inventory" ]; then
  [ -z "$reason" ] || echo "exception refused: $reason"
  echo "inventory refused: $inventory"
  exit 1
fi
if [ -n "$reason" ]; then
  echo "exception refused: $reason"
  [ -n "$unapproved" ] && echo "exposure refused:$unapproved"
  exit 1
fi
if [ -n "$unapproved" ]; then
  echo "exposure refused:$unapproved"
  exit 1
fi
echo "exposure ok"
